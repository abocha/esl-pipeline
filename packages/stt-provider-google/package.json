{
  "name": "@esl-pipeline/stt-provider-google",
  "version": "1.0.0",
  "private": true,
  "description": "Google Cloud STT V2 provider adapter for ESL Pipeline.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:unit:setup && vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/stt-core build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/stt-core": "workspace:*",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/storage": "^7.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
