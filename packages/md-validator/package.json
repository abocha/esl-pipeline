{
  "name": "@esl-pipeline/md-validator",
  "version": "3.0.1",
  "private": true,
  "description": "Validate ESL homework markdown structure and frontmatter.",
  "keywords": [
    "esl",
    "markdown",
    "validator",
    "cli"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "bin": {
    "md-validator": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @esl-pipeline/shared-infrastructure build && tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --testTimeout=15000 --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --testTimeout=15000 --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
