{
  "name": "@esl-pipeline/storage-uploader",
  "version": "2.1.0",
  "private": true,
  "description": "Upload ESL assignment assets (audio) to S3-compatible storage.",
  "keywords": [
    "esl",
    "s3",
    "upload",
    "cli"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "storage-uploader": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "tsx watch bin/cli.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config ../../vitest.config.ts --dir . --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --config ../../vitest.config.ts --dir . --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:watch": "vitest --config ../../vitest.config.ts --dir .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
