{
  "name": "@esl-pipeline/tts-provider-google",
  "version": "1.0.0",
  "private": true,
  "description": "Google Cloud TTS provider adapter for ESL Pipeline.",
  "keywords": [
    "esl",
    "tts",
    "google",
    "vertex",
    "audio"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @esl-pipeline/shared-infrastructure build && tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:unit:setup && vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/pmd build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/tts-core build",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@google-cloud/text-to-speech": "^6.4.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
