  "toolkit": {
    "grammar": [
      {
        "name": "Present simple and present continuous",

        "explanation": "Choose the form that shows whether a situation is usual or temporary.",

        "formBlocks": [
          {
            "label": "Present simple: affirmative",

            "pattern": "Subject + base verb (he/she/it: verb + -s)",

            "examples": ["She starts work at nine."]
          },

          {
            "label": "Present continuous: affirmative",

            "pattern": "Subject + am/is/are + verb-ing",

            "examples": ["They are sharing an office this month."]
          }
        ],

        "comparisons": [
          {
            "label": "Usual routine or temporary arrangement?",

            "alternatives": [
              {
                "label": "Routine",

                "example": "I work from home.",

                "explanation": "This is my usual working arrangement; choose the present simple for a routine."
              },

              {
                "label": "Temporary arrangement",

                "example": "I’m working from home this week.",

                "explanation": "This arrangement is temporary around now; choose the present continuous even when you are not working at this exact moment."
              }
            ]
          }
        ],

        "examples": [],

        "uses": [
          {
            "label": "Time expressions help show the time frame",

            "example": "Usually suggests a routine; this week can signal a temporary situation. The intended meaning still decides the form."
          }
        ],

        "traps": [
          {
            "original": "She working from home today.",

            "improved": "She is working from home today.",

            "explanation": "The continuous form needs be before the -ing verb; do not omit is."
          }
        ]
      }
    ],

