{
  "name": "@esl-pipeline/tts-provider-elevenlabs",
  "version": "1.0.0",
  "private": true,
  "description": "ElevenLabs TTS provider adapter for ESL Pipeline.",
  "keywords": [
    "esl",
    "tts",
    "elevenlabs",
    "audio"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @esl-pipeline/shared-infrastructure build && tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:integration": "vitest run \"tests/integration.test.ts\"",
    "test:unit": "pnpm run test:unit:setup && vitest run --exclude \"tests/integration.test.ts\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/pmd build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/tts-core build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --exclude \"tests/integration.test.ts\" --reporter=json --outputFile=../../tmp/test-timings/tts-provider-elevenlabs/vitest.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.42.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
