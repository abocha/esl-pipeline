{
  "name": "@esl-pipeline/tts-provider-elevenlabs",
  "version": "1.0.0",
  "private": true,
  "description": "ElevenLabs TTS provider adapter for ESL Pipeline.",
  "keywords": [
    "esl",
    "tts",
    "elevenlabs",
    "audio"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:integration": "vitest run --config ../../vitest.config.ts --dir . \"tests/integration.test.ts\"",
    "test:unit": "pnpm run test:unit:setup && vitest run --config ../../vitest.config.ts --dir . --exclude \"tests/integration.test.ts\"",
    "test:unit:prebuilt": "vitest run --config ../../vitest.config.ts --dir . --exclude \"tests/integration.test.ts\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/tts-core build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --config ../../vitest.config.ts --dir . --exclude \"tests/integration.test.ts\" --reporter=json --outputFile=../../tmp/test-timings/tts-provider-elevenlabs/vitest.json",
    "test:watch": "vitest --config ../../vitest.config.ts --dir .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
