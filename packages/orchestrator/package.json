{
  "name": "@esl-pipeline/orchestrator",
  "version": "3.6.0",
  "private": true,
  "description": "One-command ESL assignment pipeline (validation, Notion import, TTS, upload).",
  "keywords": [
    "esl",
    "pipeline",
    "notion",
    "tts"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "pnpm --filter @esl-pipeline/shared-infrastructure build && tsup --config tsup.config.ts && tsc -p tsconfig.types.json",
    "postbuild": "node ./scripts/postbuild.js",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "vitest --watch",
    "docker:build": "cd ../.. && docker build -f packages/orchestrator/Dockerfile -t esl-pipeline/orchestrator:local .",
    "docker:run": "docker run --rm esl-pipeline/orchestrator:local",
    "prepack": "pnpm run build",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude \"tests/**/*.integration.test.ts\"",
    "test:integration": "vitest run tests/pipeline.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@elevenlabs/elevenlabs-js": "^2.38.1",
    "@notionhq/client": "^5.11.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@esl-pipeline/anytype-adapter": "workspace:*",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/notion-adapter": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/storage-uploader": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@esl-pipeline/tts-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/tts-provider-google": "workspace:*",
    "@types/node": "^25.3.5",
    "tsup": "8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
