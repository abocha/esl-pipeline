{
  "name": "@esl-pipeline/orchestrator",
  "version": "3.6.0",
  "private": true,
  "description": "One-command ESL assignment pipeline (validation, HTML publishing, TTS, upload).",
  "keywords": [
    "esl",
    "pipeline",
    "html",
    "tts"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "pnpm --filter @esl-pipeline/shared-infrastructure build && tsup --config tsup.config.ts && tsc -p tsconfig.types.json",
    "postbuild": "node ./scripts/postbuild.js",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "vitest --watch",
    "docker:build": "cd ../.. && docker build -f packages/orchestrator/Dockerfile -t esl-pipeline/orchestrator:local .",
    "docker:run": "docker run --rm esl-pipeline/orchestrator:local",
    "prepack": "pnpm run build",
    "test": "pnpm run test:unit",
    "test:integration": "vitest run tests/pipeline.integration.test.ts",
    "test:unit": "pnpm run test:unit:setup && vitest run --testTimeout=150000 --exclude \"tests/**/*.integration.test.ts\"",
    "test:unit:prebuilt": "vitest run --testTimeout=150000 --exclude \"tests/**/*.integration.test.ts\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/shared-infrastructure build && pnpm --filter @esl-pipeline/pmd build && pnpm --filter @esl-pipeline/md-validator build && pnpm --filter @esl-pipeline/storage-uploader build && pnpm --filter @esl-pipeline/tts-core build && pnpm --filter @esl-pipeline/tts-provider-elevenlabs build && pnpm --filter @esl-pipeline/tts-provider-google build && pnpm --filter @esl-pipeline/html-publisher build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --testTimeout=150000 --reporter=json --outputFile=../../tmp/test-timings/orchestrator/vitest.json --exclude \"tests/**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@elevenlabs/elevenlabs-js": "^2.46.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/storage-uploader": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@esl-pipeline/tts-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/tts-provider-google": "workspace:*",
    "@types/node": "^25.7.0",
    "tsup": "8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
