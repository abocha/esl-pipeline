{
  "name": "@esl-pipeline/orchestrator",
  "version": "3.6.0",
  "private": true,
  "description": "One-command ESL assignment pipeline (validation, HTML publishing, TTS, upload).",
  "keywords": [
    "esl",
    "pipeline",
    "html",
    "tts"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.types.json",
    "postbuild": "node ./scripts/postbuild.js",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "vitest --watch --config ../../vitest.config.ts --dir .",
    "prepack": "pnpm run build",
    "test": "pnpm run test:unit",
    "test:integration": "vitest run --config ../../vitest.config.ts --dir . tests/pipeline.integration.test.ts",
    "test:unit": "pnpm run test:unit:setup && pnpm run test:unit:prebuilt",
    "test:unit:prebuilt": "node --test ../../scripts/test/provider-unit-isolation.mjs && vitest run --config ../../vitest.config.ts --dir . --testTimeout=150000 --exclude \"tests/**/*.integration.test.ts\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/contracts build && pnpm --filter @esl-pipeline/provider-runtime build && pnpm --filter @esl-pipeline/shared-infrastructure build && pnpm --filter @esl-pipeline/storage-uploader build && pnpm --filter @esl-pipeline/tts-core build && pnpm --filter @esl-pipeline/tts-provider-elevenlabs build && pnpm --filter @esl-pipeline/tts-provider-google build && pnpm --filter @esl-pipeline/tts-provider-inworld build && pnpm --filter @esl-pipeline/learner-handout build && pnpm --filter @esl-pipeline/html-publisher build && pnpm run build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --config ../../vitest.config.ts --dir . --testTimeout=150000 --reporter=json --outputFile=../../tmp/test-timings/orchestrator/vitest.json --exclude \"tests/**/*.integration.test.ts\"",
    "test:watch": "vitest --config ../../vitest.config.ts --dir .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@google-cloud/text-to-speech": "^7.1.1",
    "js-yaml": "^5.4.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/storage-uploader": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@esl-pipeline/tts-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/tts-provider-google": "workspace:*",
    "@esl-pipeline/tts-provider-inworld": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
