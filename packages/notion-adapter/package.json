{
  "name": "@esl-pipeline/notion-adapter",
  "version": "0.2.1",
  "private": true,
  "description": "Centralized Notion adapter for ESL pipeline.",
  "keywords": [
    "esl",
    "notion",
    "adapter"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@notionhq/client": "^5.4.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
