{
  "name": "@esl-pipeline/html-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTML rendering and publishing package for ESL assignment output.",
  "keywords": [
    "esl",
    "html",
    "publisher",
    "renderer"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./rendering": {
      "types": "./dist/src/rendering.d.ts",
      "import": "./dist/src/rendering.js",
      "default": "./dist/src/rendering.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:timings": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\" --reporter=json --outputFile=../../tmp/test-timings/html-publisher/vitest.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/storage-uploader": "workspace:*",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-toc-done-right": "^4.2.0"
  },
  "devDependencies": {
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^24.13.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
