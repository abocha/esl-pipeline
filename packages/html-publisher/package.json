{
  "name": "@esl-pipeline/html-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTML rendering and publishing package for ESL assignment output.",
  "keywords": [
    "esl",
    "html",
    "publisher",
    "renderer"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm test:unit:setup && vitest run --config ../../vitest.config.ts --dir . --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --config ../../vitest.config.ts --dir . --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/html-publisher... build",
    "test:unit:timings": "vitest run --config ../../vitest.config.ts --dir . --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\" --reporter=json --outputFile=../../tmp/test-timings/html-publisher/vitest.json",
    "test:watch": "vitest --config ../../vitest.config.ts --dir .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/learner-handout": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/storage-uploader": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
