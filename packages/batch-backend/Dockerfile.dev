ARG EDGE_TTS_VERSION=7.2.8

FROM node:24-alpine AS dev-base

ARG EDGE_TTS_VERSION

ENV PNPM_HOME=/pnpm
ENV EDGE_TTS_VENV=/opt/edge-tts
ENV PATH="${EDGE_TTS_VENV}/bin:${PNPM_HOME}:${PATH}" \
    ESL_EDGE_TTS_BIN="${EDGE_TTS_VENV}/bin/edge-tts" \
    ESL_EDGE_TTS_PYTHON="${EDGE_TTS_VENV}/bin/python" \
    NODE_ENV=development \
    CI=false

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

RUN corepack enable && corepack prepare pnpm@10 --activate \
    && apk add --no-cache \
        ca-certificates \
        ffmpeg \
        py3-pip \
        python3 \
    && python3 -m venv "${EDGE_TTS_VENV}" \
    && "${EDGE_TTS_VENV}/bin/pip" install --no-cache-dir "edge-tts==${EDGE_TTS_VERSION}" \
    && chmod -R a+rX "${EDGE_TTS_VENV}" \
    && mkdir -p /pnpm \
    && chmod 0777 /pnpm

WORKDIR /app

# No COPY or RUN pnpm install here.
# We rely on volume mounts and running pnpm install at runtime (or pre-installed in volume).

FROM dev-base AS dev-ops

RUN apk add --no-cache \
        aws-cli \
        bash \
        coreutils \
        curl \
        docker-cli \
        docker-cli-compose \
        findutils

FROM dev-ops AS dev-tools

ENV UV_CACHE_DIR=/uv/cache \
    UV_PYTHON_INSTALL_DIR=/uv/python \
    UV_PYTHON=3.12

RUN curl -LsSf https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && env XDG_BIN_HOME=/usr/local/bin sh /tmp/uv-install.sh --no-modify-path \
    && rm -f /tmp/uv-install.sh \
    && mkdir -p /uv/cache /uv/python \
    && chmod 0777 /uv/cache /uv/python \
    && uv python install 3.12 --install-dir /uv/python --default --no-progress

FROM dev-base AS default

FROM dev-ops AS ops

FROM dev-tools AS tools
