FROM node:24-alpine

ENV PNPM_HOME=/pnpm
ENV UV_CACHE_DIR=/uv/cache \
    UV_PYTHON_INSTALL_DIR=/uv/python \
    UV_PYTHON=3.12 \
    PATH="${PNPM_HOME}:${PATH}" \
    NODE_ENV=development \
    CI=false

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# Install system dependencies
RUN corepack enable && corepack prepare pnpm@10 --activate \
    && apk add --no-cache \
        ca-certificates \
        curl \
        ffmpeg \
    && curl -LsSf https://astral.sh/uv/install.sh | env XDG_BIN_HOME=/usr/local/bin sh -s -- --no-modify-path \
    && mkdir -p /pnpm /uv/cache /uv/python \
    && chmod 0777 /pnpm /uv/cache /uv/python \
    && uv python install 3.12 --install-dir /uv/python --default --no-progress

WORKDIR /app

# No COPY or RUN pnpm install here.
# We rely on volume mounts and running pnpm install at runtime (or pre-installed in volume).
