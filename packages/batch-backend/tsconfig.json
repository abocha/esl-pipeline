{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "paths": {
      "@esl-pipeline/contracts": ["../contracts/src/index.ts"],
      "@esl-pipeline/html-publisher": ["../html-publisher/src/index.ts"],
      "@esl-pipeline/orchestrator": ["../orchestrator/src/index.ts"],
      "@esl-pipeline/provider-runtime": ["../provider-runtime/src/index.ts"],
      "@esl-pipeline/shared-infrastructure": ["../shared-infrastructure/src/index.ts"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
