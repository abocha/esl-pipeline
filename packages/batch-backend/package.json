{
  "name": "@esl-pipeline/batch-backend",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "db:generate-baseline": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts generate-baseline",
    "db:migrate": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts migrate",
    "db:rls-audit": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts rls-audit",
    "db:status": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts status",
    "db:verify": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts verify",
    "db:verify-baseline": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts verify-baseline",
    "dev:api": "tsx watch --tsconfig tsconfig.json src/transport/http-server.ts",
    "dev:student-memory-worker": "tsx watch --tsconfig tsconfig.json src/transport/student-memory-worker.ts",
    "dev:transcribe-worker": "tsx watch --tsconfig tsconfig.json src/transport/transcribe-worker.ts",
    "dev:worker": "tsx watch --tsconfig tsconfig.json src/transport/worker-runner.ts",
    "lesson-memory:refresh": "tsx --tsconfig tsconfig.json src/tools/refresh-student-lesson-history.ts",
    "lesson-memory:refresh:dist": "node dist/tools/refresh-student-lesson-history.js",
    "lesson-memory:refresh:dist:dry": "node dist/tools/refresh-student-lesson-history.js --dry-run",
    "lesson-memory:refresh:dry": "tsx --tsconfig tsconfig.json src/tools/refresh-student-lesson-history.ts --dry-run",
    "lint": "pnpm exec biome lint . && pnpm exec eslint \"tests/**/*.{js,mjs,cjs,ts,tsx}\"",
    "profile:migrate-legacy": "tsx --tsconfig tsconfig.json src/tools/migrate-legacy-profiles.ts",
    "prompt-assets:bootstrap": "tsx --tsconfig tsconfig.json src/tools/bootstrap-prompt-assets.ts",
    "prompt-assets:bootstrap:dry": "tsx --tsconfig tsconfig.json src/tools/bootstrap-prompt-assets.ts --dry-run",
    "start:api": "node dist/transport/http-server.js",
    "start:student-memory-worker": "node dist/transport/student-memory-worker.js",
    "start:transcribe-worker": "node dist/transport/transcribe-worker.js",
    "start:worker": "node dist/transport/worker-runner.js",
    "storage:s3:smoke": "tsx --tsconfig tsconfig.json src/tools/smoke-s3-storage.ts",
    "storage:s3:smoke:dist": "node dist/tools/smoke-s3-storage.js",
    "student-artifacts:export": "tsx --tsconfig tsconfig.json src/tools/export-student-lesson-artifacts.ts",
    "student-system:backfill": "tsx --tsconfig tsconfig.json src/tools/backfill-student-system.ts",
    "student-system:backfill:dist": "node dist/tools/backfill-student-system.js",
    "student-system:backfill:dist:dry": "node dist/tools/backfill-student-system.js --dry-run",
    "student-system:backfill:dry": "tsx --tsconfig tsconfig.json src/tools/backfill-student-system.ts --dry-run",
    "student-system:verify:oneoff": "tsx --tsconfig tsconfig.json src/tools/verify-student-system-oneoff.ts",
    "test": "pnpm run test:unit",
    "test:ci": "pnpm run test:unit && pnpm run test:integration && pnpm run test:db:migrations && pnpm run test:db:postgres && pnpm run test:integration:worker",
    "test:db:migrations": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/integration.migrations.test.ts",
    "test:db:postgres": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/domain.job-repository.test.ts ../../packages/batch-backend/tests/domain.revision-repository.test.ts ../../packages/batch-backend/tests/domain.lesson-memory-repository.test.ts ../../packages/batch-backend/tests/domain.homework-memory-repository.test.ts ../../packages/batch-backend/tests/domain.student-profile-candidate-repository.test.ts ../../packages/batch-backend/tests/domain.assignment-session-repository.test.ts ../../packages/batch-backend/tests/domain.student-repository.workspace.test.ts ../../packages/batch-backend/tests/application.homework-memory-source.test.ts ../../packages/batch-backend/tests/application.student-timeline.test.ts ../../packages/batch-backend/tests/application.student-schedule-billing.test.ts ../../packages/batch-backend/tests/application.alpha-invites.registration.test.ts ../../packages/batch-backend/tests/integration.query-plan-regression.test.ts",
    "test:integration": "pnpm run test:integration:http",
    "test:integration:http": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 transport.http-server.integration.",
    "test:integration:worker": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/transport.worker-runner.integration.test.ts",
    "test:unit": "pnpm run test:unit:setup && vitest run --testTimeout=120000 --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=dot --exclude \"**/domain.job-repository.test.ts\" --exclude \"**/domain.revision-repository.test.ts\" --exclude \"**/domain.lesson-memory-repository.test.ts\" --exclude \"**/domain.homework-memory-repository.test.ts\" --exclude \"**/domain.student-profile-candidate-repository.test.ts\" --exclude \"**/domain.assignment-session-repository.test.ts\" --exclude \"**/domain.student-repository.workspace.test.ts\" --exclude \"**/application.homework-memory-source.test.ts\" --exclude \"**/application.student-timeline.test.ts\" --exclude \"**/application.student-schedule-billing.test.ts\" --exclude \"**/application.alpha-invites.registration.test.ts\" --exclude \"**/transport.http-server.integration*.test.ts\" --exclude \"**/transport.worker-runner.integration.test.ts\" --exclude \"**/integration.migrations.test.ts\" --exclude \"**/integration.query-plan-regression.test.ts\"",
    "test:unit:prebuilt": "vitest run --testTimeout=120000 --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=dot --exclude \"**/domain.job-repository.test.ts\" --exclude \"**/domain.revision-repository.test.ts\" --exclude \"**/domain.lesson-memory-repository.test.ts\" --exclude \"**/domain.homework-memory-repository.test.ts\" --exclude \"**/domain.student-profile-candidate-repository.test.ts\" --exclude \"**/domain.assignment-session-repository.test.ts\" --exclude \"**/domain.student-repository.workspace.test.ts\" --exclude \"**/application.homework-memory-source.test.ts\" --exclude \"**/application.student-timeline.test.ts\" --exclude \"**/application.student-schedule-billing.test.ts\" --exclude \"**/application.alpha-invites.registration.test.ts\" --exclude \"**/transport.http-server.integration*.test.ts\" --exclude \"**/transport.worker-runner.integration.test.ts\" --exclude \"**/integration.migrations.test.ts\" --exclude \"**/integration.query-plan-regression.test.ts\"",
    "test:unit:setup": "pnpm --filter @esl-pipeline/batch-backend... build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --testTimeout=120000 --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=json --outputFile=../../tmp/test-timings/batch-backend/vitest.json --exclude \"**/domain.job-repository.test.ts\" --exclude \"**/domain.revision-repository.test.ts\" --exclude \"**/domain.lesson-memory-repository.test.ts\" --exclude \"**/domain.homework-memory-repository.test.ts\" --exclude \"**/domain.student-profile-candidate-repository.test.ts\" --exclude \"**/domain.assignment-session-repository.test.ts\" --exclude \"**/domain.student-repository.workspace.test.ts\" --exclude \"**/application.homework-memory-source.test.ts\" --exclude \"**/application.student-timeline.test.ts\" --exclude \"**/application.student-schedule-billing.test.ts\" --exclude \"**/application.alpha-invites.registration.test.ts\" --exclude \"**/transport.http-server.integration*.test.ts\" --exclude \"**/transport.worker-runner.integration.test.ts\" --exclude \"**/integration.migrations.test.ts\" --exclude \"**/integration.query-plan-regression.test.ts\"",
    "test:verbose": "BATCH_BACKEND_TEST_LOG_LEVEL=debug vitest run --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=verbose",
    "test:watch": "vitest watch --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@elevenlabs/elevenlabs-js": "^2.46.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/orchestrator": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/stt-core": "workspace:*",
    "@esl-pipeline/stt-provider-deepgram": "workspace:*",
    "@esl-pipeline/stt-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/stt-provider-google": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@esl-pipeline/tts-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/tts-provider-google": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.8",
    "fastify": "^5.8.4",
    "file-type": "^22.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
