{
  "name": "@esl-pipeline/batch-backend",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev:api": "tsx watch src/transport/http-server.ts",
    "dev:worker": "tsx watch src/transport/worker-runner.ts",
    "db:migrate": "tsx src/tools/migrate-db.ts migrate",
    "db:status": "tsx src/tools/migrate-db.ts status",
    "db:verify": "tsx src/tools/migrate-db.ts verify",
    "db:rls-audit": "tsx src/tools/migrate-db.ts rls-audit",
    "lint": "eslint .",
    "start:api": "node dist/transport/http-server.js",
    "start:worker": "node dist/transport/worker-runner.js",
    "student-system:backfill": "tsx src/tools/backfill-student-system.ts",
    "student-system:backfill:dry": "tsx src/tools/backfill-student-system.ts --dry-run",
    "student-system:backfill:dist": "node dist/tools/backfill-student-system.js",
    "student-system:backfill:dist:dry": "node dist/tools/backfill-student-system.js --dry-run",
    "student-history:refresh": "tsx src/tools/refresh-student-lesson-history.ts",
    "student-history:refresh:dry": "tsx src/tools/refresh-student-lesson-history.ts --dry-run",
    "student-history:refresh:dist": "node dist/tools/refresh-student-lesson-history.js",
    "student-history:refresh:dist:dry": "node dist/tools/refresh-student-lesson-history.js --dry-run",
    "student-system:verify:oneoff": "tsx src/tools/verify-student-system-oneoff.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=dot --exclude \"**/domain.job-repository.test.ts\" --exclude \"**/application.student-timeline.test.ts\" --exclude \"**/transport.worker-runner.integration.test.ts\" --exclude \"**/integration.migrations.test.ts\" --exclude \"**/integration.query-plan-regression.test.ts\"",
    "test:db:migrations": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/integration.migrations.test.ts",
    "test:db:postgres": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/domain.job-repository.test.ts ../../packages/batch-backend/tests/application.student-timeline.test.ts ../../packages/batch-backend/tests/integration.query-plan-regression.test.ts",
    "test:integration:worker": "vitest run --config ../../vitest.config.ts --reporter=dot --maxWorkers=1 ../../packages/batch-backend/tests/transport.worker-runner.integration.test.ts",
    "test:ci": "pnpm run test:unit && pnpm run test:db:migrations && pnpm run test:db:postgres && pnpm run test:integration:worker",
    "test:verbose": "BATCH_BACKEND_TEST_LOG_LEVEL=debug vitest run --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests --reporter=verbose",
    "test:watch": "vitest watch --config ../../vitest.config.ts --dir ../../packages/batch-backend/tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/lib-storage": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@deepgram/sdk": "^4.11.3",
    "@elevenlabs/elevenlabs-js": "^2.25.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/notion-adapter": "workspace:*",
    "@esl-pipeline/orchestrator": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.0",
    "fastify": "^5.6.2",
    "file-type": "^21.3.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "pg": "^8.16.3",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
