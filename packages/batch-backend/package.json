{
  "name": "@esl-pipeline/batch-backend",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations",
    "schema.sql"
  ],
  "scripts": {
    "assignment-source:remap": "tsx --tsconfig tsconfig.json src/tools/remap-assignment-source.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "db:generate-baseline": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts generate-baseline",
    "db:migrate": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts migrate",
    "db:rls-audit": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts rls-audit",
    "db:status": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts status",
    "db:verify": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts verify",
    "db:verify-baseline": "tsx --tsconfig tsconfig.json src/tools/migrate-db.ts verify-baseline",
    "dev:api": "tsx watch --tsconfig tsconfig.json src/transport/http-server.ts",
    "dev:student-memory-worker": "tsx watch --tsconfig tsconfig.json src/transport/student-memory-worker.ts",
    "dev:transcribe-worker": "tsx watch --tsconfig tsconfig.json src/transport/transcribe-worker.ts",
    "dev:worker": "tsx watch --tsconfig tsconfig.json src/transport/worker-runner.ts",
    "generation:eval": "tsx --tsconfig tsconfig.json src/tools/evaluate-generation-fixtures.ts",
    "generation:eval:live": "tsx --tsconfig tsconfig.json src/tools/evaluate-generation-fixtures.ts --live",
    "lesson-memory:refresh": "tsx --tsconfig tsconfig.json src/tools/refresh-student-lesson-history.ts",
    "lesson-memory:refresh:dist": "node dist/tools/refresh-student-lesson-history.js",
    "lesson-memory:refresh:dist:dry": "node dist/tools/refresh-student-lesson-history.js --dry-run",
    "lesson-memory:refresh:dry": "tsx --tsconfig tsconfig.json src/tools/refresh-student-lesson-history.ts --dry-run",
    "lint": "pnpm exec biome lint .",
    "profile:migrate-legacy": "tsx --tsconfig tsconfig.json src/tools/migrate-legacy-profiles.ts",
    "profile:provenance-backfill": "tsx --tsconfig tsconfig.json src/tools/historical-profile-provenance.ts",
    "prompt-assets:bootstrap": "tsx --tsconfig tsconfig.json src/tools/bootstrap-prompt-assets.ts",
    "prompt-assets:bootstrap:dry": "tsx --tsconfig tsconfig.json src/tools/bootstrap-prompt-assets.ts --dry-run",
    "speech-planner:eval": "tsx --tsconfig tsconfig.json src/tools/eval-speech-planner.ts",
    "start:api": "node dist/transport/http-server.js",
    "start:student-memory-worker": "node dist/transport/student-memory-worker.js",
    "start:transcribe-worker": "node dist/transport/transcribe-worker.js",
    "start:worker": "node dist/transport/worker-runner.js",
    "storage:s3:smoke": "tsx --tsconfig tsconfig.json src/tools/smoke-s3-storage.ts",
    "storage:s3:smoke:dist": "node dist/tools/smoke-s3-storage.js",
    "student-artifacts:export": "tsx --tsconfig tsconfig.json src/tools/export-student-lesson-artifacts.ts",
    "student-memory:batch": "tsx --tsconfig tsconfig.json src/tools/student-memory-openai-batch.ts",
    "student-profile-candidate:retry": "tsx --tsconfig tsconfig.json src/tools/retry-student-profile-candidate-refresh.ts",
    "student-profile-candidate:retry:dist": "node dist/tools/retry-student-profile-candidate-refresh.js",
    "student-system:backfill": "tsx --tsconfig tsconfig.json src/tools/backfill-student-system.ts",
    "student-system:backfill:dist": "node dist/tools/backfill-student-system.js",
    "student-system:backfill:dist:dry": "node dist/tools/backfill-student-system.js --dry-run",
    "student-system:backfill:dry": "tsx --tsconfig tsconfig.json src/tools/backfill-student-system.ts --dry-run",
    "student-system:verify:oneoff": "tsx --tsconfig tsconfig.json src/tools/verify-student-system-oneoff.ts",
    "test": "pnpm run test:unit",
    "test:db:migrations": "vitest run --config vitest.config.ts --project migrations --reporter=dot",
    "test:db:postgres": "vitest run --config vitest.config.ts --project postgres --reporter=dot",
    "test:integration": "pnpm run test:integration:http",
    "test:integration:http": "vitest run --config vitest.config.ts --project http --reporter=dot",
    "test:integration:worker": "vitest run --config vitest.config.ts --project worker --reporter=dot",
    "test:media": "vitest run --config vitest.config.ts --project media --reporter=dot",
    "test:unit": "pnpm run test:unit:setup && vitest run --testTimeout=120000 --config vitest.config.ts --project pure --reporter=dot",
    "test:unit:prebuilt": "vitest run --testTimeout=120000 --config vitest.config.ts --project pure --reporter=dot",
    "test:unit:setup": "pnpm --filter @esl-pipeline/batch-backend... build",
    "test:unit:timings": "pnpm run test:unit:setup && vitest run --testTimeout=120000 --config vitest.config.ts --project pure --reporter=json --outputFile=../../tmp/test-timings/batch-backend/vitest.json",
    "test:verbose": "BATCH_BACKEND_TEST_LOG_LEVEL=debug vitest run --config vitest.config.ts --project pure --reporter=verbose",
    "test:watch": "vitest watch --config vitest.config.ts --project pure",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@esl-pipeline/contracts": "workspace:*",
    "@esl-pipeline/html-publisher": "workspace:*",
    "@esl-pipeline/md-validator": "workspace:*",
    "@esl-pipeline/orchestrator": "workspace:*",
    "@esl-pipeline/pmd": "workspace:*",
    "@esl-pipeline/provider-runtime": "workspace:*",
    "@esl-pipeline/shared-infrastructure": "workspace:*",
    "@esl-pipeline/stt-core": "workspace:*",
    "@esl-pipeline/stt-provider-deepgram": "workspace:*",
    "@esl-pipeline/stt-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/stt-provider-google": "workspace:*",
    "@esl-pipeline/tts-core": "workspace:*",
    "@esl-pipeline/tts-provider-elevenlabs": "workspace:*",
    "@esl-pipeline/tts-provider-google": "workspace:*",
    "@esl-pipeline/tts-provider-inworld": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "fastify": "^5.12.4",
    "file-type": "^22.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "oidc-provider": "9.12.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.4",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
