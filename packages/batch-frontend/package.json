{
  "name": "@esl-pipeline/batch-frontend",
  "version": "1.8.1",
  "private": true,
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "dev": "vite",
    "lint": "pnpm exec biome lint .",
    "preview": "vite preview",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --testTimeout=15000 --passWithNoTests --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:prebuilt": "vitest run --testTimeout=15000 --passWithNoTests --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\"",
    "test:unit:timings": "vitest run --testTimeout=15000 --passWithNoTests --exclude \"**/*.integration.test.ts\" --exclude \"**/*.integration.test.tsx\" --reporter=json --outputFile=../../tmp/test-timings/batch-frontend/vitest.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esl-pipeline/contracts": "workspace:*",
    "axios": "^1.20.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.3",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
