{
  // Extend the repo base config so editor/ESLint see shared settings.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Frontend-specific overrides.
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": false,
    "resolveJsonModule": true,
    // Make sure Vite/DOM types are available in the editor for ESLint/TS.
    "types": ["vite/client", "vitest"],
    // Local path aliases for this package.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Include only local package sources/config so project-service stays focused.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "../../node_modules"]
}
