# Example env for local/dev with `docker-compose.batch-backend.yml`.
# Copy to `.env.batch-backend` and edit values for your environment.
#
# Baseline philosophy:
# - Keep required core values uncommented and usable out-of-the-box.
# - Keep optional/advanced controls documented nearby as commented toggles.
# - Prefer canonical provider-namespaced STT/TTS variables (`ESL_STT_*`, `ESL_TTS_*`).

####################################################################################################
# 1) Runtime / API Surface
####################################################################################################

NODE_ENV=development
BATCH_BACKEND_HTTP_PORT=8080
LOG_LEVEL=info

# Enable/disable the extended (auth/uploads/admin) API surface.
BATCH_BACKEND_ENABLE_EXTENDED_API=true

####################################################################################################
# 2) Core Infrastructure (Postgres / Redis / Queue)
####################################################################################################

# PostgreSQL
PG_ENABLED=true
PG_HOST=postgres
PG_PORT=5432
PG_USER=esl
PG_PASSWORD=esl
PG_DATABASE=esl_batch
PG_POOL_MAX=8
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Alternative single-string connection:
# PG_CONNECTION_STRING=postgresql://esl:esl@postgres:5432/esl_batch

# Migration controls
# PG_AUTO_MIGRATE_ON_BOOT=true
# PG_MIGRATION_LOCK_KEY=910001
# PG_MIGRATIONS_DIR=/app/packages/batch-backend/src/migrations

# Redis / BullMQ
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

BATCH_JOBS_QUEUE_NAME=esl-jobs
TRANSCRIBE_QUEUE_NAME=transcribe-queue

####################################################################################################
# 3) Orchestrator Credentials / Publishing Targets
####################################################################################################

# Notion integration token (required for import/update pages).
NOTION_TOKEN=changeme-notion-token

# Optional: default database for jobs without explicit override.
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional compatibility alias used in some integration paths/UI helpers.
# NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Notion DB options for frontend selector (id:name entries).
# NOTION_DB_OPTIONS=notion-db-1:B1 Lessons,notion-db-2:B2 Lessons
# NOTION_DB_NAME=Primary database
# NOTION_DB_LABEL=Primary database

# Optional Notion client/network tuning.
# NOTION_CLIENT_TIMEOUT=120000
# NOTION_COLORIZER_THROTTLE_MS=200
# NOTION_COLORIZER_MAX_RETRIES=5
# NOTION_COLORIZER_RETRY_DELAY_MS=350

# Anytype adapter (optional)
# ANYTYPE_API_URL=http://host.docker.internal:31009/v1
# ANYTYPE_API_VERSION=2025-11-08
# ANYTYPE_TOKEN=changeme-anytype-token
# ANYTYPE_SPACE_ID=your-space-id
# ANYTYPE_SPACE_NAME=My Space
# ANYTYPE_COLLECTION_ID=your-collection-id

####################################################################################################
# 4) Speech Providers (TTS + STT)
####################################################################################################

# STT provider ids: deepgram | elevenlabs | google
# Canonical default provider (used when request does not override sttProvider)
ESL_STT_DEFAULT_PROVIDER=deepgram
# Optional hard override for runtime selection (takes precedence when set)
# STT_PROVIDER=deepgram

# Provider availability/order for metadata surfaces (/config/job-options)
ESL_STT_PROVIDER_ORDER=deepgram,elevenlabs,google
TRANSCRIBE_MODE=timeline
TRANSCRIBE_MAX_CONCURRENCY=3

# Canonical STT provider config
ESL_STT_PROVIDER_DEEPGRAM_API_KEY=changeme-deepgram
# ESL_STT_PROVIDER_DEEPGRAM_ACCESS_TOKEN=
ESL_STT_PROVIDER_DEEPGRAM_MODEL=nova-3
ESL_STT_PROVIDER_DEEPGRAM_LANGUAGE=multi

# ElevenLabs STT defaults (Scribe v2)
# ESL_STT_PROVIDER_ELEVENLABS_API_KEY=changeme-elevenlabs-stt
# ESL_STT_PROVIDER_ELEVENLABS_API_TOKEN=changeme-elevenlabs-stt-token
# ESL_STT_PROVIDER_ELEVENLABS_MODEL=scribe_v2

# Google Cloud STT V2 (required when effective STT provider is google)
# GOOGLE_STT_PROJECT_ID=your-gcp-project-id
# (Fallback alias accepted by SDK/config): GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_STT_LOCATION=us
# GOOGLE_STT_RECOGNIZER=
# GOOGLE_STT_MODEL=latest_long
# GOOGLE_STT_LANGUAGE_CODES=en-US
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json
# Required for non-gs:// input artifacts (upload/local storage path):
# GOOGLE_STT_GCS_STAGING_BUCKET=your-stt-staging-bucket
# GOOGLE_STT_GCS_STAGING_PREFIX=stt-staging

# STT debug/raw response persistence
ESL_STT_STORE_RAW_RESPONSE=true

# Legacy aliases remain supported but emit deprecation warnings.
# Keep these UNSET in normal operation:
#   DEEPGRAM_API_KEY
#   DEEPGRAM_ACCESS_TOKEN
#   DEEPGRAM_MODEL
#   DEEPGRAM_LANGUAGE
#   DEEPGRAM_STORE_RAW_RESPONSE
#   ELEVENLABS_API_KEY
#   ELEVENLABS_API_TOKEN

# Canonical TTS provider selection/order
# ESL_TTS_DEFAULT_PROVIDER=elevenlabs
# ESL_TTS_PROVIDER_ORDER=elevenlabs,google

# ElevenLabs TTS credentials + model/output defaults
ESL_TTS_PROVIDER_ELEVENLABS_API_KEY=changeme-elevenlabs
# ESL_TTS_PROVIDER_ELEVENLABS_API_TOKEN=
# ESL_TTS_PROVIDER_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ESL_TTS_PROVIDER_ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# ElevenLabs TTS strategy/dialogue tuning
# ESL_TTS_PROVIDER_ELEVENLABS_STRATEGY=auto
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_LANGUAGE=en
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_STABILITY=0.7
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_SEED=0
# ESL_TTS_PROVIDER_ELEVENLABS_MAX_CHARS=4500
# ESL_TTS_PROVIDER_ELEVENLABS_SILENCE_TAIL_SECONDS=0.4

# Optional voice catalog override paths
# ELEVENLABS_VOICES_PATH=/app/packages/orchestrator/configs/elevenlabs.voices.json
# ESL_TTS_PROVIDER_ELEVENLABS_VOICES_PATH=/app/packages/orchestrator/configs/elevenlabs.voices.json

# Google TTS defaults (model families: chirp3_hd | studio | neural2 | wavenet)
# ESL_TTS_PROVIDER_GOOGLE_MODEL=chirp3_hd
# ESL_TTS_PROVIDER_GOOGLE_MODEL_NAME=
# ESL_TTS_PROVIDER_GOOGLE_LANGUAGE_CODE=en-US
# ESL_TTS_PROVIDER_GOOGLE_LOCATION=us
# ESL_TTS_PROVIDER_GOOGLE_API_ENDPOINT=
# ESL_TTS_PROVIDER_GOOGLE_VOICE_CHIRP3_HD=en-US-Chirp3-HD-Charon
# ESL_TTS_PROVIDER_GOOGLE_VOICE_STUDIO=en-US-Studio-O
# ESL_TTS_PROVIDER_GOOGLE_VOICE_NEURAL2=en-US-Neural2-F
# ESL_TTS_PROVIDER_GOOGLE_VOICE_WAVENET=en-US-Wavenet-F
# ESL_TTS_PROVIDER_GOOGLE_MAX_BYTES=5000

# Shared TTS debug switch
# ESL_TTS_DEBUG=0

# Voice alignment rollout flags
# VOICE_ALIGNMENT_V2_ENABLED=false
# VOICE_ALIGNMENT_V2_STRICT_VALIDATION=false
# VOICE_ALIGNMENT_V2_MIN_SCORE=20
# VOICE_ALIGNMENT_V2_PROMPT=false

####################################################################################################
# 5) Worker / Pipeline Execution
####################################################################################################

WORKER_CONCURRENCY=6
MAX_CONCURRENT_FFMPEG=3

# Persistent TTS cache
BATCH_TTS_CACHE_DIR=/app/tmp/tts-cache
BATCH_TTS_CACHE_MAX_AGE_DAYS=14
BATCH_TTS_CACHE_MAX_BYTES=6442450944
BATCH_TTS_CACHE_MAINTENANCE_INTERVAL_MINUTES=30
BATCH_TTS_CACHE_MAINTENANCE_LOCK_KEY=910021

# Recording size cap (bytes)
RECORDINGS_MAX_FILE_SIZE=104857600

# Upload storage path inside container
FILESYSTEM_UPLOAD_DIR=/app/uploads

# Export materialized markdown locally under FILESYSTEM_UPLOAD_DIR/drafts
DRAFT_LOCAL_EXPORT=true

# Optional orchestrator working directory override
PIPELINE_CWD=/app

####################################################################################################
# 6) Auth / Security / Upload Controls
####################################################################################################

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=esl_refresh
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/
BCRYPT_ROUNDS=12

# Upload + content safety
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=text/markdown,text/plain
UPLOAD_RATE_LIMIT=10
UPLOAD_BURST_LIMIT=20
ENABLE_FILE_VALIDATION=true
ENABLE_FILE_SANITIZATION=true
ENABLE_RATE_LIMITING=true
ENABLE_SECURITY_LOGGING=true
JOB_SUBMISSION_RATE_LIMIT=0
UPLOAD_QUOTA_PER_USER=104857600

# CORS / headers
ENABLE_CORS=false
CORS_CREDENTIALS=false
# CORS_ORIGIN=http://localhost:5173
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

####################################################################################################
# 7) Storage / S3
####################################################################################################

# Storage provider: filesystem | s3
# STORAGE_PROVIDER=filesystem

# S3 credential aliases (either S3_* or AWS_* accepted)
AWS_REGION=us-east-1
# S3_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket
# S3_BUCKET=your-bucket
# STORAGE_BUCKET_NAME=your-bucket
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret

# Optional S3 endpoint tuning
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false
# S3_PATH_PREFIX=audio/assignments
# STORAGE_PATH_PREFIX=audio/assignments

# Presigned URL expiry
PRESIGNED_URL_EXPIRES_IN=3600

# Multipart upload controls (if your upload stack uses them)
ENABLE_MULTIPART_UPLOADS=true
MAX_MULTIPART_SIZE=104857600

####################################################################################################
# 8) Manifest Store / Config Provider
####################################################################################################

ESL_PIPELINE_MANIFEST_STORE=filesystem
ESL_PIPELINE_MANIFEST_BUCKET=esl-pipeline
ESL_PIPELINE_MANIFEST_PREFIX=manifests/dev
ESL_PIPELINE_MANIFEST_ROOT=/workspace

ESL_PIPELINE_CONFIG_PROVIDER=local
# ESL_PIPELINE_CONFIG_DIR=/workspace/packages/orchestrator/configs
# ESL_PIPELINE_CONFIG_ENDPOINT=https://config.example.com
# ESL_PIPELINE_CONFIG_TOKEN=changeme
ESL_PIPELINE_CONFIG_CACHE_TTL_MS=120000
ESL_PIPELINE_CONFIG_CACHE_STALE_IF_ERROR_MS=900000
# ESL_PIPELINE_CONFIG_CONDITIONAL_REQUESTS=true

# Keep false by default to avoid silently serving stale/static metadata.
BATCH_BACKEND_JOB_OPTIONS_ALLOW_STATIC_FALLBACK=false

####################################################################################################
# 9) Prompt Assets / Student System
####################################################################################################

PROMPT_TEMPLATE_PATH=docs/templates/hw_prompt_v4-2_clean.md
PROMPT_PROFILE_PATH=docs/templates/PROFILE_2025-11-16.md

# Student profile storage is DB-only.

####################################################################################################
# 10) Draft Generation Providers (WS2B / WS3.5)
####################################################################################################

OPENAI_API_KEY=changeme-openai
GEMINI_API_KEY=changeme-gemini
OPENROUTER_API_KEY=changeme-openrouter
# OPENROUTER_HTTP_REFERER=https://your-domain.example
# OPENROUTER_X_TITLE=ESL Pipeline

GEN_PROVIDER_DEFAULT=openai
GEN_PROVIDER_FALLBACKS=google_ai_studio,openrouter
GEN_QUOTA_SOURCE_MODE=hybrid

GEN_OPENAI_MODEL_PRIMARY=gpt-5.2
GEN_OPENAI_MODEL_FALLBACK=gpt-5-mini
GEN_GOOGLE_MODEL_PRIMARY=gemini-3-flash-preview
GEN_GOOGLE_MODEL_FALLBACK=gemini-2.5-flash-lite
GEN_GOOGLE_MODEL_TERTIARY=gemini-2.5-pro
# GEN_OPENROUTER_MODEL_PRIMARY=openrouter/auto
# GEN_OPENROUTER_MODEL_FALLBACK=openrouter/auto-fallback

GEN_ALLOWED_MODELS_OPENAI=gpt-5.2,gpt-5-mini
GEN_ALLOWED_MODELS_GOOGLE=gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-pro
GEN_ALLOWED_MODELS_OPENROUTER=

GEN_SAFETY_MODE=hard_stop
GEN_STRICT_NO_PAID=true
GEN_MAX_OUTPUT_TOKENS_HARD=1200
GEN_ALLOW_PAID_SPEND=false
# GEN_BUDGET_EMERGENCY_OVERRIDE=false

GEN_OPENAI_DAILY_TOKEN_BUDGET=120000
GEN_OPENAI_DAILY_REQUEST_BUDGET=40
GEN_OPENAI_RPM_BUDGET=3
GEN_GOOGLE_DAILY_REQUEST_BUDGET=12
GEN_GOOGLE_RPM_BUDGET=4
GEN_OPENROUTER_DAILY_TOKEN_BUDGET=0
GEN_OPENROUTER_DAILY_REQUEST_BUDGET=0
GEN_OPENROUTER_RPM_BUDGET=0

GEN_OPENAI_REQUEST_TIMEOUT_MS=30000
GEN_OPENAI_RETRY_MAX=1
GEN_OPENAI_RETRY_BACKOFF_MS=250
GEN_GOOGLE_REQUEST_TIMEOUT_MS=30000
GEN_GOOGLE_RETRY_MAX=1
GEN_GOOGLE_RETRY_BACKOFF_MS=250
GEN_OPENROUTER_REQUEST_TIMEOUT_MS=30000
GEN_OPENROUTER_RETRY_MAX=1
GEN_OPENROUTER_RETRY_BACKOFF_MS=250

####################################################################################################
# 11) Mail / SMTP (Optional)
####################################################################################################

MAIL_ENABLED=false
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@example.local
MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=

####################################################################################################
# 12) Backup / Ops (Optional)
####################################################################################################

# PG_BACKUP_S3_BUCKET=esl-pipeline-db-backups
# PG_BACKUP_S3_PREFIX=backups/postgres
# PG_BACKUP_S3_REGION=us-east-1
# PG_BACKUP_S3_SSE=aws:kms
# PG_BACKUP_S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PG_BACKUP_S3_ENV=dev
# PG_BACKUP_S3_PROFILE=default
# Empty-source guard for backup creation (anchor tables: users,jobs,transcripts).
# Default false blocks creating/uploading snapshots from an empty app-data DB.
# PG_BACKUP_ALLOW_EMPTY_SOURCE=false
# PG_BACKUP_LOCAL_RETENTION_DAYS=30
# PG_BACKUP_REMOTE_RESTORE_RETENTION_DAYS=14
# PG_BACKUP_LOG_RETENTION_DAYS=30
# PG_BACKUP_HEALTH_MAX_BACKUP_AGE_HOURS=26
# PG_BACKUP_HEALTH_MAX_DRILL_AGE_DAYS=35
# PG_BACKUP_KEY_ROTATION_MAX_AGE_DAYS=80
# PG_BACKUP_ALERT_COOLDOWN_MINUTES=360
# PG_BACKUP_IAM_USER=esl-backup-uploader
# Optional explicit postgres container target for backup/restore scripts.
# Recommended for containerized ops-control actions to avoid docker-compose discovery.
# PG_CONTAINER_NAME=esl-pipeline-postgres-1
# PG_BACKUP_RESTORE_DRILL_REPORT_LATEST=/app/tmp/logs/backup/restore-drill-report-latest.json
# PG_BACKUP_ALERT_TELEGRAM_BOT_TOKEN=123456789:telegram-bot-token
# PG_BACKUP_ALERT_TELEGRAM_CHAT_ID=-1001234567890
# PG_BACKUP_ALERT_TELEGRAM_THREAD_ID=42
# PG_BACKUP_ALERT_TELEGRAM_DISABLE=false
# PG_BACKUP_RESTORE_DRILL_AUTO=false

####################################################################################################
# 13) Telegram Ops Control Panel (Optional)
####################################################################################################

# Backend ops control API gate (admin-auth routes under /ops/*)
# BATCH_BACKEND_ENABLE_OPS_CONTROL=false

# Optional shared secret required by /ops/* in addition to admin auth.
# Recommended when exposing /ops to bot-only automation clients.
# BATCH_BACKEND_OPS_CONTROL_BOT_SECRET=change-me-shared-secret

# Ops control command wrappers (default to existing repo scripts).
# Production backend runtime must include bash/aws/docker (+ coreutils/findutils), so these defaults run as-is.
# Override these when runtime path/host environment differs.
# BATCH_BACKEND_OPS_CONTROL_STATUS_COMMAND="bash scripts/docker/postgres-ops-status.sh --json"
# BATCH_BACKEND_OPS_CONTROL_BACKUP_COMMAND="bash scripts/docker/postgres-backup-s3.sh backup-upload"
# BATCH_BACKEND_OPS_CONTROL_RESTORE_DRILL_COMMAND="PG_BACKUP_RESTORE_DRILL_AUTO=true bash scripts/docker/run-postgres-restore-drill-reminder.sh"
# BATCH_BACKEND_OPS_CONTROL_ACTION_TIMEOUT_MS=600000
# History target for ops action statuses. Queued/running actions are never evicted;
# temporary overflow can occur until active actions complete.
# BATCH_BACKEND_OPS_CONTROL_ACTION_HISTORY_LIMIT=100
# Retention window for persisted/terminal ops action history pruning.
# BATCH_BACKEND_OPS_CONTROL_ACTION_RETENTION_DAYS=30

# Telegram bot runtime gate and credentials
# TELEGRAM_OPS_BOT_ENABLED=false
# TELEGRAM_OPS_BOT_API_BASE_URL=https://api.telegram.org
# TELEGRAM_OPS_BOT_MODE=polling
# TELEGRAM_OPS_BOT_LEADER_ELECTION_ENABLED=false
# TELEGRAM_OPS_BOT_APPROVAL_REPLAY_DATABASE_URL=postgres://esl:esl@postgres:5432/esl_batch
# TELEGRAM_OPS_BOT_APPROVAL_REPLAY_PRUNE_INTERVAL_MS=60000
# TELEGRAM_OPS_BOT_WEBHOOK_HOST=0.0.0.0
# TELEGRAM_OPS_BOT_WEBHOOK_PORT=8091
# TELEGRAM_OPS_BOT_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_OPS_BOT_WEBHOOK_SECRET_TOKEN=change-me
# TELEGRAM_OPS_BOT_TOKEN=123456789:telegram-bot-token
# TELEGRAM_OPS_BOT_CHAT_ID=-1001234567890
# TELEGRAM_OPS_BOT_ALLOWED_USER_IDS=12345678,87654321

# Backend service-account auth used by the bot (admin account recommended)
# TELEGRAM_OPS_BOT_BACKEND_URL=http://batch-backend:8080
# TELEGRAM_OPS_BOT_BACKEND_EMAIL=ops-bot@example.com
# TELEGRAM_OPS_BOT_BACKEND_PASSWORD=change-me
# TELEGRAM_OPS_BOT_BACKEND_TIMEOUT_MS=15000
# TELEGRAM_OPS_BOT_BACKEND_SHARED_SECRET=change-me-shared-secret

# Polling and command safety controls
# TELEGRAM_OPS_BOT_POLL_INTERVAL_MS=1500
# TELEGRAM_OPS_BOT_POLL_TIMEOUT_SECONDS=20
# TELEGRAM_OPS_BOT_COMMAND_WINDOW_MS=60000
# TELEGRAM_OPS_BOT_MAX_COMMANDS_PER_WINDOW=20
# Run read-only by default; set true only after manual command validation.
# TELEGRAM_OPS_BOT_ENABLE_ACTION_COMMANDS=false
# Skip old queued Telegram updates at boot to avoid replaying stale commands.
# TELEGRAM_OPS_BOT_SKIP_PENDING_UPDATES_ON_STARTUP=true

# Thread/topic routing controls
# TELEGRAM_OPS_BOT_TOPIC_AUTO_CREATE=true
# TELEGRAM_OPS_BOT_DEFAULT_THREAD_ID=42
# TELEGRAM_OPS_BOT_TOPICS_STATE_FILE=/app/tmp/state/telegram-ops-topics.json
# TELEGRAM_OPS_BOT_TOPIC_NAME_OPS="Ops Control"
# TELEGRAM_OPS_BOT_TOPIC_NAME_JOBS=Jobs
# TELEGRAM_OPS_BOT_TOPIC_NAME_ALERTS=Alerts

# Optional frontend URL for pretty job/recording links in Telegram messages.
# TELEGRAM_OPS_BOT_APP_BASE_URL=https://batch.example.com

####################################################################################################
# 14) Compatibility / Discovery Helpers (Optional)
####################################################################################################

# Optional repo roots for catalog discovery scripts.
# REPO_ROOT=/app
# APP_ROOT=/app
# PROJECT_ROOT=/app
