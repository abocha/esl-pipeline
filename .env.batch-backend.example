# Example env for local/dev with `docker-compose.batch-backend.yml`.
# Copy to `.env.batch-backend` and edit as needed.
#
# This file is optimized for readability (grouped by feature). It is NOT a production template.

####################################################################################################
# Runtime / server
####################################################################################################

NODE_ENV=development

# Batch backend HTTP port (container listens on this port).
BATCH_BACKEND_HTTP_PORT=8080

# Backend logger (pino): trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Enable/disable the extended (auth/uploads/admin) API surface.
BATCH_BACKEND_ENABLE_EXTENDED_API=true

####################################################################################################
# Orchestrator credentials (required for real pipeline runs)
####################################################################################################

# Notion integration token (required to import/update pages).
NOTION_TOKEN=changeme-notion-token

# Optional: if set, becomes the default database for jobs without an explicit override.
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: fallback Notion DB options for the UI (comma-separated id:name entries).
# NOTION_DB_OPTIONS=notion-db-1:B1 Lessons,notion-db-2:B2 Lessons
# NOTION_DB_ID=notion-db-1
# NOTION_DB_NAME=Primary database
# NOTION_DB_LABEL=Primary database

# Notion client timeout (ms). Helpful when the worker experiences slow networks / rate limiting.
# NOTION_CLIENT_TIMEOUT=120000

# Notion colorizer pacing (optional; helps with Notion rate limits during heading colorization).
# NOTION_COLORIZER_THROTTLE_MS=200
# NOTION_COLORIZER_MAX_RETRIES=5
# NOTION_COLORIZER_RETRY_DELAY_MS=350

# ElevenLabs API key (required for TTS if `withTts` is enabled).
ELEVENLABS_API_KEY=changeme-elevenlabs

# Optional: override voice catalog JSON (used by /config/job-options fallback).
# ELEVENLABS_VOICES_PATH=/app/configs/elevenlabs.voices.json

# Optional repo roots for voice catalog discovery.
# REPO_ROOT=/app
# APP_ROOT=/app
# PROJECT_ROOT=/app

####################################################################################################
# ElevenLabs TTS defaults (optional)
####################################################################################################

# Default strategy: auto | dialogue | tts
# ELEVENLABS_TTS_STRATEGY=auto

# Enable extra debug logs from @esl-pipeline/tts-elevenlabs (0/1).
# ELEVENLABS_TTS_DEBUG=0

# Dialogue-specific options (only relevant when strategy resolves to `dialogue`).
# ELEVENLABS_DIALOGUE_LANGUAGE=en
# ELEVENLABS_DIALOGUE_STABILITY=0.7
# ELEVENLABS_DIALOGUE_SEED=0

# TTS chunking (only relevant for `tts` strategy).
# ELEVENLABS_TTS_MAX_CHARS=4500

####################################################################################################
# Postgres (jobs + user settings)
####################################################################################################

PG_ENABLED=true
PG_HOST=postgres
PG_PORT=5432
PG_USER=esl
PG_PASSWORD=esl
PG_DATABASE=esl_batch
# Alternative single-string connection:
# PG_CONNECTION_STRING=postgresql://esl:esl@postgres:5432/esl_batch

####################################################################################################
# Redis + BullMQ (job queue)
####################################################################################################

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# BullMQ queue name
BATCH_JOBS_QUEUE_NAME=esl-jobs
# Transcription queue name
TRANSCRIBE_QUEUE_NAME=transcribe-queue

####################################################################################################
# Recordings + transcription
####################################################################################################

# Root recordings folder to scan (leave empty to disable scan mode).
RECORDINGS_ROOT=/recordings

# Glob pattern for scan mode.
RECORDINGS_GLOB=**/*.{opus,mp3,wav,m4a}

# Scan interval in seconds.
RECORDINGS_SCAN_INTERVAL_SEC=120

# Transcription mode: timeline | stack
TRANSCRIBE_MODE=timeline

# Max concurrent transcriptions per worker.
TRANSCRIBE_MAX_CONCURRENCY=2

####################################################################################################
# Deepgram (transcription)
####################################################################################################

DEEPGRAM_API_KEY=changeme-deepgram
# DEEPGRAM_ACCESS_TOKEN=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_STORE_RAW_RESPONSE=true

####################################################################################################
# Worker performance controls
####################################################################################################

# Max concurrent jobs handled by the worker process.
WORKER_CONCURRENCY=5

# Caps concurrent FFmpeg operations (must be <= WORKER_CONCURRENCY).
MAX_CONCURRENT_FFMPEG=3

####################################################################################################
# Auth (extended API)
####################################################################################################

# IMPORTANT: change in production.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

####################################################################################################
# Uploads + security controls (extended API)
####################################################################################################

# Filesystem path inside the container for uploads (docker-compose mounts this volume).
FILESYSTEM_UPLOAD_DIR=/app/uploads
# Orchestrator working directory inside the container.
PIPELINE_CWD=/app

# Max upload size in bytes (default is 10MB).
MAX_FILE_SIZE=10485760

# Max recording upload size in bytes (default is 100MB).
RECORDINGS_MAX_FILE_SIZE=104857600

# Comma-separated list of MIME types accepted for uploads.
ALLOWED_MIME_TYPES=text/markdown,text/plain

# Upload rate limiting (per-minute + burst).
UPLOAD_RATE_LIMIT=10
UPLOAD_BURST_LIMIT=20

# Toggle security subsystems.
ENABLE_FILE_VALIDATION=true
ENABLE_FILE_SANITIZATION=true
ENABLE_RATE_LIMITING=true
ENABLE_SECURITY_LOGGING=true

# Rate limit job submissions (0 disables).
JOB_SUBMISSION_RATE_LIMIT=0

# Per-user upload quota in bytes (default 100MB).
UPLOAD_QUOTA_PER_USER=104857600

####################################################################################################
# CORS (enable only if you host the frontend separately)
####################################################################################################

ENABLE_CORS=false
CORS_CREDENTIALS=false
# CORS_ORIGIN=http://localhost:5173

####################################################################################################
# Security headers
####################################################################################################

SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

####################################################################################################
# Storage (audio uploads / generated files)
####################################################################################################

# Storage provider: 'filesystem' or 's3'.
# If unset, the backend auto-selects 's3' when credentials are present, otherwise 'filesystem'.
# STORAGE_PROVIDER=filesystem

# When using S3 storage:
AWS_REGION=us-east-1
# S3_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket
# S3_BUCKET=your-bucket
# STORAGE_BUCKET_NAME=your-bucket
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret
# Optional S3 endpoint (for MinIO/etc).
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false
# Optional prefix inside bucket:
# S3_PATH_PREFIX=audio/assignments
# STORAGE_PATH_PREFIX=audio/assignments
# Presigned URL expiry (seconds):
PRESIGNED_URL_EXPIRES_IN=3600
# Multipart upload controls.
ENABLE_MULTIPART_UPLOADS=true
MAX_MULTIPART_SIZE=104857600

####################################################################################################
# Manifest store (pipeline reruns/status)
####################################################################################################

# filesystem | s3
ESL_PIPELINE_MANIFEST_STORE=filesystem

# Required when manifest store is s3:
ESL_PIPELINE_MANIFEST_BUCKET=esl-pipeline
ESL_PIPELINE_MANIFEST_PREFIX=manifests/dev

# Root directory for filesystem manifests (inside container).
ESL_PIPELINE_MANIFEST_ROOT=/workspace

####################################################################################################
# Config provider (presets/voices/students)
####################################################################################################

# local | http
ESL_PIPELINE_CONFIG_PROVIDER=local

# Optional: point orchestrator at a specific config dir inside the container.
# ESL_PIPELINE_CONFIG_DIR=/workspace/configs

# Remote config provider (only if CONFIG_PROVIDER=http):
# ESL_PIPELINE_CONFIG_ENDPOINT=https://config.example.com
# ESL_PIPELINE_CONFIG_TOKEN=changeme

####################################################################################################
# Prompt assets (Phase 2+ prompt packages)
####################################################################################################

# Prompt template + profile defaults (allowlisted for /config/prompts).
PROMPT_TEMPLATE_PATH=docs/templates/hw_prompt_v4-2_clean.md
PROMPT_PROFILE_PATH=docs/templates/PROFILE_2025-11-16.md

####################################################################################################
# Mail / SMTP (optional)
####################################################################################################

MAIL_ENABLED=false
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@example.local
MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
