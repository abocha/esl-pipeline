{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/**",
      "scripts/**",
      "package.json",
      "vitest.config.ts",
      "!**/dist",
      "!coverage",
      "!docs/generated",
      "!out",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "noImportantStyles": "off",
        "noUselessConstructor": "off",
        "noUselessContinue": "off",
        "noUselessStringRaw": "off",
        "noUselessTernary": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useExponentiationOperator": "off",
        "useExportType": "off",
        "useImportType": "off",
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": {
            "allowConstantExport": true
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noFocusedTests": "error",
        "noImplicitAnyLet": "off",
        "noMisleadingCharacterClass": "off",
        "noSkippedTests": "warn"
      },
      "nursery": {
        "noConditionalExpect": "warn",
        "noIdenticalTestTitle": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.{js,mjs,cjs,ts,tsx}",
        "**/*.spec.{js,mjs,cjs,ts,tsx}",
        "**/tests/**/*.{js,mjs,cjs,ts,tsx}"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noUselessEscapeInString": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/batch-frontend/src/context/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":NODE:",
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:",
                "!@esl-pipeline/*",
                "!@esl-pipeline/**"
              ],
              ":BLANK_LINE:",
              ["@esl-pipeline/*", "@esl-pipeline/**"],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "useSortedPackageJson": {
          "level": "on"
        }
      }
    }
  }
}
