{
  "name": "esl-pipeline",
  "version": "6.0.5",
  "private": true,
  "description": "ESL assignment pipeline tooling (validation, Notion import, TTS, S3 upload).",
  "keywords": [
    "esl",
    "notion",
    "tts",
    "cli",
    "pipeline"
  ],
  "homepage": "https://github.com/abocha/esl-pipeline",
  "bugs": {
    "url": "https://github.com/abocha/esl-pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abocha/esl-pipeline.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration:prebuilt && pnpm test:backend:db:worker",
    "check:fast": "pnpm guard:orchestrator:boundary && pnpm build && pnpm lint && pnpm --filter @esl-pipeline/orchestrator test && pnpm --filter @esl-pipeline/batch-backend test && pnpm --filter @esl-pipeline/batch-frontend test",
    "clean": "pnpm -r --filter './packages/*' --if-present run clean",
    "clean:artifacts": "node -e \"const fs=require('node:fs'); for (const dir of ['out','tmp','uploads']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "deps:audit": "pnpm exec knip --dependencies --reporter compact --no-progress --no-exit-code",
    "deps:audit:strict": "pnpm exec knip --dependencies --reporter compact --no-progress",
    "deps:check": "pnpm deps:pin && git diff --quiet --exit-code",
    "deps:pin": "node scripts/deps/pin-shared-deps.mjs",
    "deps:upgrade:safe": "node scripts/deps/safe-upgrade.mjs",
    "dev:batch": "concurrently -k -n api,worker,memory,frontend -c cyan,magenta,yellow,green \"pnpm --filter @esl-pipeline/batch-backend dev:api\" \"pnpm --filter @esl-pipeline/batch-backend dev:worker\" \"pnpm --filter @esl-pipeline/batch-backend dev:student-memory-worker\" \"pnpm --filter @esl-pipeline/batch-frontend dev\"",
    "dev:orchestrator": "pnpm --filter @esl-pipeline/orchestrator dev",
    "dev:telegram-ops-bot": "pnpm --filter @esl-pipeline/telegram-ops-bot dev",
    "docker:backup": "pnpm docker:db:backup",
    "docker:db:backup": "bash scripts/docker/postgres-backup-restore.sh backup",
    "docker:db:backup:s3": "bash scripts/docker/postgres-backup-s3.sh backup-upload",
    "docker:db:backup:s3:scheduled": "bash scripts/docker/run-postgres-backup-s3.sh",
    "docker:db:backups": "bash scripts/docker/postgres-backup-restore.sh list",
    "docker:db:list:s3": "bash scripts/docker/postgres-backup-s3.sh list-remote",
    "docker:db:restore": "bash scripts/docker/postgres-backup-restore.sh restore",
    "docker:db:restore:s3": "bash scripts/docker/postgres-backup-s3.sh restore-remote",
    "docker:db:restore-drill:auto": "PG_BACKUP_RESTORE_DRILL_AUTO=true bash scripts/docker/run-postgres-restore-drill-reminder.sh",
    "docker:db:restore-drill:reminder": "bash scripts/docker/run-postgres-restore-drill-reminder.sh",
    "docker:db:upload:s3": "bash scripts/docker/postgres-backup-s3.sh upload-latest",
    "docker:db:verify-backup": "bash scripts/docker/postgres-backup-restore.sh verify",
    "docker:dev": "pnpm docker:up",
    "docker:dev:build": "pnpm docker:up:build",
    "docker:dev:down": "docker compose -p esl-pipeline -f docker-compose.yml down --remove-orphans",
    "docker:dev:ps": "docker compose -p esl-pipeline -f docker-compose.yml ps",
    "docker:dev:recover": "pnpm docker:prepare && bash scripts/docker/recover-dev-stack.sh",
    "docker:lint": "dclint docker-compose.yml docker-compose.prod.yml --max-warnings 0",
    "docker:lint:fix": "dclint docker-compose.yml docker-compose.prod.yml --fix",
    "docker:prepare": "bash scripts/docker/prepare-host-paths.sh",
    "docker:prod": "pnpm docker:prepare && docker compose -p esl-pipeline-prod -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -p esl-pipeline-prod -f docker-compose.prod.yml down --remove-orphans",
    "docker:prod:ps": "docker compose -p esl-pipeline-prod -f docker-compose.prod.yml ps",
    "docker:restart": "pnpm docker:dev:down && pnpm docker:up",
    "docker:up": "pnpm docker:prepare && docker compose -p esl-pipeline -f docker-compose.yml up -d",
    "docker:up:build": "pnpm docker:prepare && docker compose -p esl-pipeline -f docker-compose.yml up -d --build",
    "docs:check": "pnpm docs:check:core && pnpm docs:check:ops && pnpm docs:check:non-core",
    "docs:check:core": "node scripts/docs/check-core-docs.mjs",
    "docs:check:non-core": "node scripts/docs/check-non-core-docs.mjs",
    "docs:check:ops": "node scripts/docs/check-active-ops-docs.mjs",
    "docs:garden": "node scripts/docs/generate-docs-gardening.mjs",
    "docs:gardening": "pnpm docs:garden",
    "docs:generate:indexes": "node scripts/docs/generate-docs-indexes.mjs",
    "docs:health:report": "node scripts/docs/generate-docs-health-report.mjs",
    "docs:stale:active": "node scripts/docs/find-stale-active-docs.mjs",
    "format": "pnpm run format:biome && pnpm run format:prettier",
    "format:biome": "pnpm exec biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "format:biome:write": "pnpm exec biome check --write --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "format:prettier": "pnpm exec prettier --check \"**/*.{md,yml,yaml}\" \"**/package.json\"",
    "format:prettier:write": "pnpm exec prettier --write \"**/*.{md,yml,yaml}\" \"**/package.json\"",
    "format:write": "pnpm run format:biome:write && pnpm run format:prettier:write",
    "guard:orchestrator:boundary": "node scripts/release/guard-orchestrator-library-boundary.mjs",
    "hadolint": "rg --files -g 'Dockerfile*' | xargs -r hadolint",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint:specialized",
    "lint:biome": "pnpm exec biome lint .",
    "lint:eslint:specialized": "pnpm exec eslint \"packages/batch-frontend/**/*.{ts,tsx}\" \"packages/**/*.{test,spec}.{js,mjs,cjs,ts,tsx}\"",
    "lint:repo-hygiene": "pnpm run lint:workflows && pnpm run lint:shell",
    "lint:shell": "find scripts -type f \\( -name '*.sh' -o -name '*.bash' \\) -print0 | xargs -0 -r shellcheck",
    "lint:sqlfluff": "bash -lc 'mkdir -p tmp/.uv-cache tmp/.uv-tools && UV_CACHE_DIR=$PWD/tmp/.uv-cache UV_TOOL_DIR=$PWD/tmp/.uv-tools uv tool run --from sqlfluff sqlfluff lint --dialect postgres packages/batch-backend/migrations packages/batch-backend/docker-entrypoint-initdb.d'",
    "lint:workflows": "actionlint",
    "notes:pr-style": "bash scripts/git/pr-style-summary.sh",
    "ops:alert:check": "bash scripts/docker/run-postgres-ops-alert.sh",
    "ops:key-rotation:check": "bash scripts/docker/run-aws-key-rotation-reminder.sh",
    "ops:status": "bash scripts/docker/postgres-ops-status.sh",
    "ops:status:json": "bash scripts/docker/postgres-ops-status.sh --json",
    "ops:telegram:ga:gates": "node scripts/release/telegram-ops-go-live-gates.mjs",
    "ops:telegram:preflight": "node scripts/release/telegram-ops-go-live-preflight.mjs",
    "ops:telegram:verify": "node scripts/release/telegram-ops-go-live-verify.mjs",
    "release:compute-next-version": "node scripts/release/compute-next-version.mjs",
    "release:resolve-pr-bump": "node scripts/release/resolve-release-bump-from-pr.mjs",
    "release:verify:contracts": "node scripts/release/verify-contract-version-consistency.mjs",
    "smoke": "pnpm --filter @esl-pipeline/orchestrator test",
    "test": "pnpm run test:unit",
    "test:backend:db:worker": "node scripts/test/run-backend-db-worker-check.mjs",
    "test:coverage:core": "node scripts/test/run-core-coverage.mjs",
    "test:coverage:report": "node scripts/test/generate-coverage-report.mjs",
    "test:integration": "pnpm build && pnpm run test:integration:prebuilt",
    "test:integration:prebuilt": "pnpm -r --parallel --workspace-concurrency=4 --filter './packages/*' --if-present run test:integration",
    "test:timings:frontend": "pnpm run test:timings:unit",
    "test:timings:report": "node scripts/test/generate-frontend-timing-report.mjs",
    "test:timings:unit": "node scripts/test/run-frontend-unit-timings.mjs",
    "test:topo": "pnpm -r --filter './packages/*' run test",
    "test:unit": "node scripts/test/assert-test-unit-scripts.mjs && pnpm -r --parallel --workspace-concurrency=4 --filter './packages/*' --if-present run test:unit",
    "test:watch": "pnpm -r --filter './packages/*' --if-present run test:watch",
    "typecheck": "pnpm -r --filter './packages/*' --if-present run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.13",
    "concurrently": "^9.2.1",
    "dclint": "3.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "knip": "^6.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.11.1"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "fast-xml-parser": "^5.5.8",
      "ioredis": "^5.10.1",
      "minimatch": "^10.2.4",
      "rollup": "^4.59.0",
      "yaml": "^2.8.3"
    }
  }
}
