{
  "name": "esl-pipeline",
  "version": "10.5.2",
  "private": true,
  "description": "ESL assignment pipeline tooling (validation, HTML publishing, TTS, S3 upload).",
  "keywords": [
    "esl",
    "html",
    "tts",
    "cli",
    "pipeline"
  ],
  "homepage": "https://github.com/abocha/esl-pipeline",
  "bugs": {
    "url": "https://github.com/abocha/esl-pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abocha/esl-pipeline.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "check": "pnpm test:tooling && pnpm build && pnpm typecheck && pnpm lint && pnpm test:unit:prebuilt && pnpm test:integration:prebuilt && pnpm test:backend:db:worker",
    "check:fast": "node scripts/check/run-affected-check.mjs",
    "check:fast:agent": "node scripts/check/run-affected-check.mjs --agent",
    "check:fast:dry-run": "node scripts/check/run-affected-check.mjs --dry-run",
    "check:pre-pr": "node scripts/check/run-affected-check.mjs --broad",
    "clean": "pnpm -r --filter \"./packages/*\" --if-present run clean",
    "clean:artifacts": "node -e \"const fs=require('node:fs'); for (const dir of ['out','tmp','uploads']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "deps:audit": "pnpm exec knip --dependencies --reporter compact --no-progress --no-exit-code",
    "deps:audit:strict": "pnpm exec knip --dependencies --reporter compact --no-progress",
    "dev:batch": "concurrently -k -n api,worker,memory,frontend -c cyan,magenta,yellow,green \"pnpm --filter @esl-pipeline/batch-backend dev:api\" \"pnpm --filter @esl-pipeline/batch-backend dev:worker\" \"pnpm --filter @esl-pipeline/batch-backend dev:student-memory-worker\" \"pnpm --filter @esl-pipeline/batch-frontend dev\"",
    "dev:orchestrator": "pnpm --filter @esl-pipeline/orchestrator dev",
    "dev:telegram-ops-bot": "pnpm --filter @esl-pipeline/telegram-ops-bot dev",
    "docker:caddy:validate": "pnpm docker:prod:edge:env && node scripts/docker/validate-caddy-config.mjs",
    "docker:db:backup": "bash scripts/docker/postgres-backup-restore.sh backup",
    "docker:db:backup:s3": "bash scripts/docker/postgres-backup-s3.sh backup-upload",
    "docker:db:backup:s3:scheduled": "bash scripts/docker/run-postgres-backup-s3.sh",
    "docker:db:backups": "bash scripts/docker/postgres-backup-restore.sh list",
    "docker:db:list:s3": "bash scripts/docker/postgres-backup-s3.sh list-remote",
    "docker:db:restore": "bash scripts/docker/postgres-backup-restore.sh restore",
    "docker:db:restore:s3": "bash scripts/docker/postgres-backup-s3.sh restore-remote",
    "docker:db:restore-drill:auto": "PG_BACKUP_RESTORE_DRILL_AUTO=true bash scripts/docker/run-postgres-restore-drill-reminder.sh",
    "docker:db:restore-drill:reminder": "bash scripts/docker/run-postgres-restore-drill-reminder.sh",
    "docker:db:upload:s3": "bash scripts/docker/postgres-backup-s3.sh upload-latest",
    "docker:db:verify-backup": "bash scripts/docker/postgres-backup-restore.sh verify",
    "docker:dev:clean-deps": "pnpm docker:dev:down && node scripts/docker/clean-dev-dependency-volumes.mjs",
    "docker:dev:down": "docker compose -p esl-pipeline -f docker-compose.yml down --remove-orphans",
    "docker:dev:ps": "docker compose -p esl-pipeline -f docker-compose.yml ps",
    "docker:dev:recover": "pnpm docker:prepare && bash scripts/docker/recover-dev-stack.sh",
    "docker:lint": "pnpm docker:lint:compose && pnpm docker:lint:dockerfiles",
    "docker:lint:compose": "dclint docker-compose.yml docker-compose.prod.yml --max-warnings 0",
    "docker:lint:compose:fix": "dclint docker-compose.yml docker-compose.prod.yml --fix",
    "docker:lint:dockerfiles": "node scripts/docker/run-hadolint.mjs",
    "docker:prepare": "node scripts/docker/prepare-host-paths.mjs",
    "docker:prod": "pnpm docker:prod:images:env && pnpm docker:prepare && node scripts/docker/prod-compose.mjs up -d --no-build",
    "docker:prod:config": "node scripts/docker/prod-compose.mjs --placeholder-images config --quiet",
    "docker:prod:db:backup:s3": "bash scripts/docker/postgres-prod-backup-s3.sh backup-upload",
    "docker:prod:db:list:s3": "bash scripts/docker/postgres-prod-backup-s3.sh list-remote",
    "docker:prod:db:restore:s3": "bash scripts/docker/postgres-prod-backup-s3.sh restore-remote",
    "docker:prod:db:upload:s3": "bash scripts/docker/postgres-prod-backup-s3.sh upload-latest",
    "docker:prod:down": "node scripts/docker/prod-compose.mjs --placeholder-images down --remove-orphans",
    "docker:prod:edge": "pnpm docker:prod:edge:env && pnpm docker:prod:images:env && pnpm docker:prepare && node scripts/docker/prod-compose.mjs --profile edge up -d --no-build",
    "docker:prod:edge:config": "pnpm docker:prod:edge:env && node scripts/docker/prod-compose.mjs --placeholder-images --profile edge config --quiet",
    "docker:prod:edge:down": "node scripts/docker/prod-compose.mjs --placeholder-images --profile edge down --remove-orphans",
    "docker:prod:edge:env": "node scripts/docker/validate-edge-env.mjs",
    "docker:prod:images:env": "node scripts/docker/validate-prod-image-env.mjs",
    "docker:prod:ops-bot:config": "node scripts/docker/prod-compose.mjs --placeholder-images --profile ops-bot config --quiet",
    "docker:prod:ps": "node scripts/docker/prod-compose.mjs --placeholder-images ps",
    "docker:restart": "pnpm docker:dev:down && pnpm docker:up",
    "docker:up": "pnpm docker:prepare && docker compose -p esl-pipeline -f docker-compose.yml up -d",
    "docker:up:build": "pnpm docker:prepare && docker compose -p esl-pipeline -f docker-compose.yml up -d --build",
    "docs:check": "pnpm docs:check:core && pnpm docs:check:ops && pnpm docs:check:non-core",
    "docs:check:core": "node scripts/docs/check-core-docs.mjs",
    "docs:check:non-core": "node scripts/docs/check-non-core-docs.mjs",
    "docs:check:ops": "node scripts/docs/check-active-ops-docs.mjs",
    "docs:garden": "node scripts/docs/generate-docs-gardening.mjs",
    "docs:generate:indexes": "node scripts/docs/generate-docs-indexes.mjs",
    "docs:generate:plans-index": "node scripts/docs/generate-plans-index.mjs",
    "docs:health:report": "node scripts/docs/generate-docs-health-report.mjs",
    "docs:stale:active": "node scripts/docs/find-stale-active-docs.mjs",
    "env:validate": "tsx --tsconfig packages/batch-backend/tsconfig.json packages/batch-backend/src/tools/validate-env.ts",
    "env:validate:example": "pnpm env:validate -- --example --profile=development",
    "eval:speech-planner": "pnpm --filter @esl-pipeline/batch-backend speech-planner:eval",
    "format": "pnpm run format:biome && pnpm run format:prettier",
    "format:biome": "pnpm exec biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "format:biome:write": "pnpm exec biome check --write --formatter-enabled=true --linter-enabled=false --assist-enabled=true .",
    "format:prettier": "pnpm exec prettier --check \"**/*.{md,yml,yaml}\" \"**/package.json\"",
    "format:prettier:write": "pnpm exec prettier --write \"**/*.{md,yml,yaml}\" \"**/package.json\"",
    "format:write": "pnpm run format:biome:write && pnpm run format:prettier:write",
    "guard:orchestrator:boundary": "node scripts/release/guard-orchestrator-library-boundary.mjs",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint:specialized",
    "lint:biome": "pnpm exec biome lint .",
    "lint:eslint:specialized": "pnpm exec eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/specialized \"packages/batch-frontend/**/*.{ts,tsx}\" \"packages/**/*.{test,spec}.{js,mjs,cjs,ts,tsx}\"",
    "lint:repo-hygiene": "pnpm run lint:workflows && pnpm run lint:shell",
    "lint:shell": "node scripts/check/lint-shell.mjs",
    "lint:sqlfluff": "bash -lc 'mkdir -p tmp/.uv-cache tmp/.uv-tools && UV_CACHE_DIR=$PWD/tmp/.uv-cache UV_TOOL_DIR=$PWD/tmp/.uv-tools uv tool run --from sqlfluff sqlfluff lint --dialect postgres packages/batch-backend/migrations packages/batch-backend/docker-entrypoint-initdb.d'",
    "lint:workflows": "actionlint",
    "notes:pr-style": "bash scripts/git/pr-style-summary.sh",
    "ops:alert:check": "bash scripts/docker/run-postgres-ops-alert.sh",
    "ops:key-rotation:check": "bash scripts/docker/run-aws-key-rotation-reminder.sh",
    "ops:status": "bash scripts/docker/postgres-ops-status.sh",
    "ops:status:json": "bash scripts/docker/postgres-ops-status.sh --json",
    "ops:telegram:ga:gates": "node scripts/release/telegram-ops-go-live-gates.mjs",
    "ops:telegram:preflight": "node scripts/release/telegram-ops-go-live-preflight.mjs",
    "ops:telegram:verify": "node scripts/release/telegram-ops-go-live-verify.mjs",
    "release:compute-next-version": "node scripts/release/compute-next-version.mjs",
    "release:resolve-pr-bump": "node scripts/release/resolve-release-bump-from-pr.mjs",
    "release:verify:contracts": "node scripts/release/verify-contract-version-consistency.mjs",
    "test": "pnpm run test:unit",
    "test:agent:html-publisher": "node scripts/test/run-agent-vitest-lane.mjs --lane html-publisher --script test:unit --filter @esl-pipeline/html-publisher",
    "test:backend:db:worker": "node scripts/test/run-backend-db-worker-check.mjs",
    "test:backend:db:worker:agent": "node scripts/test/run-agent-vitest-lane.mjs --lane backend-db-worker --script test:db:migrations --script test:db:postgres --script test:integration:worker --filter @esl-pipeline/batch-backend --backend-db-env",
    "test:check-routing": "node --test scripts/check/*.test.mjs",
    "test:coverage:core": "node scripts/test/run-core-coverage.mjs",
    "test:coverage:report": "node scripts/test/generate-coverage-report.mjs",
    "test:integration": "pnpm build && pnpm run test:integration:prebuilt",
    "test:integration:prebuilt": "pnpm -r --parallel --workspace-concurrency=4 --filter \"./packages/*\" --if-present run test:integration",
    "test:integration:prebuilt:agent": "node scripts/test/run-agent-vitest-lane.mjs --lane integration-prebuilt --script test:integration",
    "test:timings:report": "node scripts/test/generate-unit-timing-report.mjs",
    "test:timings:unit": "node scripts/test/run-unit-timings.mjs",
    "test:tooling": "node --test \"scripts/**/*.test.mjs\"",
    "test:unit": "node scripts/test/assert-test-unit-scripts.mjs && pnpm -r --parallel --workspace-concurrency=4 --filter \"./packages/*\" --if-present run test:unit",
    "test:unit:agent": "node scripts/test/run-agent-vitest-lane.mjs --lane unit --script test:unit",
    "test:unit:prebuilt": "node scripts/test/assert-test-unit-scripts.mjs && pnpm -r --parallel --workspace-concurrency=4 --filter \"./packages/*\" --if-present run test:unit:prebuilt",
    "test:unit:prebuilt:agent": "node scripts/test/run-agent-vitest-lane.mjs --lane unit-prebuilt --script test:unit:prebuilt",
    "test:unit:prebuilt:fast": "pnpm -r --parallel --workspace-concurrency=3 --filter @esl-pipeline/orchestrator --filter @esl-pipeline/batch-backend --filter @esl-pipeline/batch-frontend run test:unit:prebuilt",
    "test:unit:prebuilt:fast:agent": "node scripts/test/run-agent-vitest-lane.mjs --lane unit-prebuilt-fast --script test:unit:prebuilt --filter @esl-pipeline/orchestrator --filter @esl-pipeline/batch-backend --filter @esl-pipeline/batch-frontend",
    "test:watch": "pnpm -r --filter \"./packages/*\" --if-present run test:watch",
    "typecheck": "pnpm -r --filter \"./packages/*\" --if-present run typecheck",
    "voices:sync": "pnpm exec tsx packages/tts-provider-elevenlabs/src/tools/sync-voices-cli.ts",
    "voices:sync:watch": "pnpm exec tsx packages/tts-provider-elevenlabs/src/tools/sync-voices-cli.ts --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@elevenlabs/elevenlabs-js": "^2.54.0",
    "@eslint-react/eslint-plugin": "^5.9.5",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "concurrently": "^10.0.3",
    "dclint": "3.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "knip": "^6.21.0",
    "prettier": "^3.8.5",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "engines": {
    "node": ">=24.11.1"
  }
}
