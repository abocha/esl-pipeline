{
  "name": "esl-pipeline",
  "version": "2.3.0",
  "private": true,
  "description": "ESL assignment pipeline tooling (validation, Notion import, TTS, S3 upload).",
  "keywords": [
    "esl",
    "notion",
    "tts",
    "cli",
    "pipeline"
  ],
  "homepage": "https://github.com/abocha/esl-pipeline",
  "bugs": {
    "url": "https://github.com/abocha/esl-pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abocha/esl-pipeline.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check:fast": "pnpm build && pnpm lint && pnpm --filter @esl-pipeline/orchestrator test && pnpm --filter @esl-pipeline/batch-backend test && pnpm --filter @esl-pipeline/batch-frontend test",
    "clean": "pnpm -r --filter './packages/*' --if-present run clean",
    "clean:artifacts": "node -e \"const fs=require('node:fs'); for (const dir of ['out','tmp','uploads']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "deps:audit": "pnpm exec knip --dependencies --reporter compact --no-progress --no-exit-code",
    "deps:audit:strict": "pnpm exec knip --dependencies --reporter compact --no-progress",
    "deps:check": "pnpm deps:pin && git diff --quiet --exit-code",
    "deps:pin": "node scripts/deps/pin-shared-deps.mjs",
    "deps:upgrade:safe": "node scripts/deps/safe-upgrade.mjs",
    "dev:batch": "concurrently -k -n api,worker,frontend -c cyan,magenta,green \"pnpm --filter @esl-pipeline/batch-backend dev:api\" \"pnpm --filter @esl-pipeline/batch-backend dev:worker\" \"pnpm --filter @esl-pipeline/batch-frontend dev\"",
    "dev:orchestrator": "pnpm --filter @esl-pipeline/orchestrator dev",
    "docker:prepare": "bash scripts/docker/prepare-host-paths.sh",
    "docker:up": "pnpm docker:prepare && docker compose up -d",
    "docker:up:build": "pnpm docker:prepare && docker compose up -d --build",
    "docker:dev": "pnpm docker:up",
    "docker:dev:build": "pnpm docker:up:build",
    "docker:dev:down": "docker compose down --remove-orphans",
    "docker:db:backup": "bash scripts/docker/postgres-backup-restore.sh backup",
    "docker:db:backups": "bash scripts/docker/postgres-backup-restore.sh list",
    "docker:db:restore": "bash scripts/docker/postgres-backup-restore.sh restore",
    "docker:db:verify-backup": "bash scripts/docker/postgres-backup-restore.sh verify",
    "docker:lint": "dclint docker-compose.yml docker-compose.prod.yml --max-warnings 0",
    "docker:lint:fix": "dclint docker-compose.yml docker-compose.prod.yml --fix",
    "docker:prod": "pnpm docker:prepare && docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down --remove-orphans",
    "esl": "node packages/orchestrator/dist/cli.js",
    "format": "pnpm exec prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:write": "pnpm exec prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "hadolint": "rg --files -g 'Dockerfile*' | xargs -r hadolint",
    "lint": "pnpm exec eslint packages",
    "smoke": "pnpm --filter @esl-pipeline/orchestrator test",
    "test": "pnpm -r --filter './packages/*' run test",
    "test:watch": "pnpm -r --filter './packages/*' --if-present run test:watch",
    "typecheck": "pnpm -r --filter './packages/*' --if-present run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "concurrently": "^9.2.1",
    "dclint": "3.1.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.3.0",
    "knip": "^5.85.0",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "pnpm": {
    "overrides": {
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "@trivago/prettier-plugin-sort-imports>lodash-es": "^4.17.23",
      "minimatch": "^10.2.2"
    }
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
