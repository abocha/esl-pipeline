{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "biome.json",
    "pnpm-workspace.yaml",
    "vitest.config.ts"
  ],
  "globalEnv": [
    "BATCH_BACKEND_*",
    "CI",
    "NODE_ENV",
    "PG_*",
    "REDIS_*",
    "TZ",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "tsconfig*.tsbuildinfo"]
    }
  }
}
