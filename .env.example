# Example env for running the CLI / orchestrator locally.
# Copy to `.env` and fill in real credentials.
#
# Runtime: Node 24.11.1+ (see `.nvmrc`).

####################################################################################################
# Notion (required for import/update)
####################################################################################################

NOTION_TOKEN=secret_xxxxx

# Optional: default Notion database id used by some flows.
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backward-compatible alias used in a few places:
# NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: data source for student lookup in some setups
# STUDENTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion client timeout (ms). Helpful when Notion requests take longer or networks are flaky.
# NOTION_CLIENT_TIMEOUT=120000

# Notion colorizer pacing (optional; helps with Notion rate limits during heading colorization).
# NOTION_COLORIZER_THROTTLE_MS=200
# NOTION_COLORIZER_MAX_RETRIES=5
# NOTION_COLORIZER_RETRY_DELAY_MS=350

####################################################################################################
# ElevenLabs (required for TTS)
####################################################################################################

ELEVENLABS_API_KEY=elevenlabs_xxxxx

# Model/output format overrides (defaults shown)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# TTS strategy defaults (auto | dialogue | tts)
# ELEVENLABS_TTS_STRATEGY=auto

# Enable extra debug logs from @esl-pipeline/tts-elevenlabs (0/1)
# ELEVENLABS_TTS_DEBUG=0

# Dialogue-specific options (only relevant when strategy resolves to `dialogue`)
# ELEVENLABS_DIALOGUE_LANGUAGE=en
# ELEVENLABS_DIALOGUE_STABILITY=0.7
# ELEVENLABS_DIALOGUE_SEED=0

# TTS chunking (only relevant for `tts` strategy)
# ELEVENLABS_TTS_MAX_CHARS=4500

####################################################################################################
# AWS / S3 (used for audio uploads when upload=s3)
####################################################################################################

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=esl-notion-tts
S3_PREFIX=audio/assignments
# Optional: planned max upload size for S3 uploads (MB; enforced in Stage 6)
# S3_UPLOAD_MAX_MB=50 # Max upload size (MB) for S3 audio uploads.

####################################################################################################
# Manifest store (assignment reruns/status)
####################################################################################################

# filesystem | s3 (default: filesystem)
# ESL_PIPELINE_MANIFEST_STORE=filesystem

# For S3 manifests, set:
# ESL_PIPELINE_MANIFEST_STORE=s3
# ESL_PIPELINE_MANIFEST_BUCKET=esl-pipeline-manifests
# ESL_PIPELINE_MANIFEST_PREFIX=manifests/dev
# ESL_PIPELINE_MANIFEST_ROOT=/workspace

####################################################################################################
# Config provider (optional)
####################################################################################################

# local | http
# ESL_PIPELINE_CONFIG_PROVIDER=http
# ESL_PIPELINE_CONFIG_ENDPOINT=https://config.example.com
# ESL_PIPELINE_CONFIG_TOKEN=changeme

# Optional: point orchestrator at a specific config dir
# ESL_PIPELINE_CONFIG_DIR=./configs

####################################################################################################
# Optional: behavior toggles
####################################################################################################

# LOG_LEVEL=info
