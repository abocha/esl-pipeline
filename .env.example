# Example env for running the CLI / orchestrator locally.
# Copy to `.env` and fill in real credentials.
#
# Runtime: Node 24.11.1+ (see `.nvmrc`).

####################################################################################################
# TTS providers
####################################################################################################

# Default provider + fallback order
# ESL_TTS_DEFAULT_PROVIDER=elevenlabs
# ESL_TTS_PROVIDER_ORDER=elevenlabs,google

# ElevenLabs
ESL_TTS_PROVIDER_ELEVENLABS_API_KEY=elevenlabs_xxxxx

# Model/output format overrides (defaults shown)
# ESL_TTS_PROVIDER_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ESL_TTS_PROVIDER_ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# TTS strategy defaults (auto | dialogue | tts)
# ESL_TTS_PROVIDER_ELEVENLABS_STRATEGY=auto

# Optional Google block
# ESL_TTS_PROVIDER_GOOGLE_MODEL=chirp3_hd
# ESL_TTS_PROVIDER_GOOGLE_MODEL_NAME=
# ESL_TTS_PROVIDER_GOOGLE_LANGUAGE_CODE=en-US
# ESL_TTS_PROVIDER_GOOGLE_LOCATION=us
# ESL_TTS_PROVIDER_GOOGLE_API_ENDPOINT=
# ESL_TTS_PROVIDER_GOOGLE_VOICE_CHIRP3_HD=en-US-Chirp3-HD-Charon
# ESL_TTS_PROVIDER_GOOGLE_VOICE_STUDIO=en-US-Studio-O
# ESL_TTS_PROVIDER_GOOGLE_VOICE_NEURAL2=en-US-Neural2-F
# ESL_TTS_PROVIDER_GOOGLE_VOICE_WAVENET=en-US-Wavenet-F
# ESL_TTS_PROVIDER_GOOGLE_MAX_BYTES=5000

# Voice alignment v2 controls
# VOICE_ALIGNMENT_V2_ENABLED=false
# VOICE_ALIGNMENT_V2_STRICT_VALIDATION=false
# VOICE_ALIGNMENT_V2_MIN_SCORE=20

# Dialogue-specific options (only relevant when strategy resolves to `dialogue`)
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_LANGUAGE=en
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_STABILITY=0.7
# ESL_TTS_PROVIDER_ELEVENLABS_DIALOGUE_SEED=0

# TTS chunking (only relevant for `tts` strategy)
# ESL_TTS_PROVIDER_ELEVENLABS_MAX_CHARS=4500

# Enable extra debug logs from TTS providers (0/1)
# ESL_TTS_DEBUG=0

# Optional pronunciation helper overrides for server-side edge-tts synthesis.
# Repo Docker images provision these automatically; override only for custom runtimes.
# ESL_EDGE_TTS_BIN=/opt/edge-tts/bin/edge-tts
# ESL_EDGE_TTS_PYTHON=/opt/edge-tts/bin/python
# ESL_EDGE_TTS_VOICE=en-US-AriaNeural
# Use only English Edge voices here, for example:
# ESL_EDGE_TTS_VOICE=en-US-AriaNeural
# ESL_EDGE_TTS_VOICE=en-GB-SoniaNeural
# Optional pronunciation-specific ElevenLabs model override.
# ESL_TTS_PROVIDER_ELEVENLABS_PRONUNCIATION_MODEL_ID=eleven_flash_v2_5

####################################################################################################
# AWS / S3 (used for audio uploads when upload=s3)
####################################################################################################

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=esl-html-publish
S3_PREFIX=audio/assignments
# Optional: planned max upload size for S3 uploads (MB; enforced in Stage 6)
# S3_UPLOAD_MAX_MB=50 # Max upload size (MB) for S3 audio uploads.

# Optional: Postgres backup archive storage (separate from audio upload prefix).
# PG_BACKUP_S3_BUCKET=esl-pipeline-db-backups
# PG_BACKUP_S3_PREFIX=backups/postgres
# PG_BACKUP_S3_REGION=ap-southeast-1
# PG_BACKUP_S3_SSE=aws:kms
# PG_BACKUP_S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PG_BACKUP_S3_ENV=dev
# PG_BACKUP_S3_PROFILE=default
# Optional scheduled-maintenance controls.
# PG_BACKUP_LOCAL_RETENTION_DAYS=30
# PG_BACKUP_REMOTE_RESTORE_RETENTION_DAYS=14
# PG_BACKUP_LOG_RETENTION_DAYS=30
# PG_BACKUP_RESTORE_DRILL_AUTO=false

####################################################################################################
# Manifest store (assignment reruns/status)
####################################################################################################

# filesystem | s3 (default: filesystem)
# ESL_PIPELINE_MANIFEST_STORE=filesystem

# For S3 manifests, set:
# ESL_PIPELINE_MANIFEST_STORE=s3
# ESL_PIPELINE_MANIFEST_BUCKET=esl-pipeline-manifests
# ESL_PIPELINE_MANIFEST_PREFIX=manifests/dev
# ESL_PIPELINE_MANIFEST_ROOT=/workspace

####################################################################################################
# Config provider (optional)
####################################################################################################

# local | http
# ESL_PIPELINE_CONFIG_PROVIDER=http
# ESL_PIPELINE_CONFIG_ENDPOINT=https://config.example.com
# ESL_PIPELINE_CONFIG_TOKEN=changeme
# ESL_PIPELINE_CONFIG_CACHE_TTL_MS=60000
# ESL_PIPELINE_CONFIG_CACHE_STALE_IF_ERROR_MS=300000
# ESL_PIPELINE_CONFIG_CONDITIONAL_REQUESTS=true

# Optional: point orchestrator at a specific config dir
# ESL_PIPELINE_CONFIG_DIR=./configs

####################################################################################################
# Direct LLM Generation (WS2B/WS3.5; used by batch-backend generation endpoints)
####################################################################################################

# Provider API keys (set at least one to use direct generation)
# OPENAI_API_KEY=sk-xxxx
# GEMINI_API_KEY=AIzaSyxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxx

# Optional OpenRouter ranking/telemetry headers
# OPENROUTER_HTTP_REFERER=https://your-domain.example
# OPENROUTER_X_TITLE=ESL Pipeline

# Provider selection / ladder
# GEN_PROVIDER_DEFAULT=openai
# GEN_PROVIDER_FALLBACKS=google_ai_studio,openrouter
# GEN_QUOTA_SOURCE_MODE=hybrid

# Model defaults
# GEN_OPENAI_MODEL_PRIMARY=gpt-5.4-mini
# GEN_OPENAI_MODEL_FALLBACK=gpt-5.4-nano
# GEN_OPENAI_MODEL_STUDENT_MEMORY_PRIMARY=gpt-5.4-nano
# GEN_OPENAI_MODEL_STUDENT_MEMORY_FALLBACK=gpt-5.4-mini
# GEN_OPENAI_MODEL_PROFILE_DRAFT_PRIMARY=gpt-5.4
# GEN_OPENAI_MODEL_PROFILE_DRAFT_FALLBACK=gpt-5.4-mini
# GEN_OPENAI_MODEL_PROFILE_DRAFT_TERTIARY=gpt-5.4-nano
# GEN_GOOGLE_MODEL_PRIMARY=gemini-3-flash-preview
# GEN_GOOGLE_MODEL_FALLBACK=gemini-2.5-flash-lite
# GEN_GOOGLE_MODEL_TERTIARY=gemini-2.5-pro
# GEN_OPENROUTER_MODEL_PRIMARY=openrouter/auto
# GEN_OPENROUTER_MODEL_FALLBACK=openrouter/auto-fallback

# Strict allowlists (comma-separated)
# GEN_ALLOWED_MODELS_OPENAI=gpt-5.4-mini,gpt-5.4-nano
# GEN_ALLOWED_MODELS_GOOGLE=gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
# GEN_ALLOWED_MODELS_OPENROUTER=

# Safety defaults (recommended)
# GEN_SAFETY_MODE=hard_stop
# GEN_STRICT_NO_PAID=true
# GEN_MAX_OUTPUT_TOKENS_HARD=3200

# Floodgates toggle:
# - When true, bypasses strict allowlists + hard budget checks.
# - Use only when you intentionally allow paid usage.
# GEN_ALLOW_PAID_SPEND=false

# Provider runtime budgets (set to 0 to hard-block that dimension)
# GEN_OPENAI_DAILY_TOKEN_BUDGET=120000
# GEN_OPENAI_DAILY_REQUEST_BUDGET=40
# GEN_OPENAI_RPM_BUDGET=3
# GEN_GOOGLE_DAILY_REQUEST_BUDGET=12
# GEN_GOOGLE_RPM_BUDGET=4
# GEN_OPENROUTER_DAILY_TOKEN_BUDGET=0
# GEN_OPENROUTER_DAILY_REQUEST_BUDGET=0
# GEN_OPENROUTER_RPM_BUDGET=0

# Provider runtime timeout/retry controls
# GEN_OPENAI_REQUEST_TIMEOUT_MS=240000
# GEN_OPENAI_RETRY_MAX=1
# GEN_OPENAI_RETRY_BACKOFF_MS=250
# GEN_GOOGLE_REQUEST_TIMEOUT_MS=240000
# GEN_GOOGLE_RETRY_MAX=1
# GEN_GOOGLE_RETRY_BACKOFF_MS=250
# GEN_OPENROUTER_REQUEST_TIMEOUT_MS=240000
# GEN_OPENROUTER_RETRY_MAX=1
# GEN_OPENROUTER_RETRY_BACKOFF_MS=250

####################################################################################################
# Optional: behavior toggles
####################################################################################################

# LOG_LEVEL=info
